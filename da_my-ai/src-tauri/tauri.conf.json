{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "my-ai-gui",
  "version": "0.1.0",
  "identifier": "com.diegonmarcos.my-ai",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "my-ai",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "Utility",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
