      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "ssh\\s+\\S+.*\\.(secrets|env)\\b.*>",
        "ci": false
      },
      "reason": "SSH write-redirect into a VM secret file bypasses sops",
      "alt": "src/secrets.yaml on host + build.sh ship",
      "tests": {
        "deny": [
          "ssh oci-apps 'cat x > /opt/app/.env'"
        ],
        "allow": [
          "ssh oci-apps 'ls'"
        ]
      }
    },
    {
      "id": "warn-docker-e-literal",
      "level": "warn",
      "category": "secrets",
      "reversibility": "irreversible",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "docker\\s+(run|exec)\\s+.*-e\\s+[A-Z_]+=[A-Za-z0-9+/=._-]{16,}",
        "ci": false
      },
      "reason": "docker -e with literal credential value — leaks via shell history + ps",
      "alt": "--env-file dist/.secrets (or compose env_file:)",
      "tests": {
        "deny": [
          "docker run -e API_KEY=abcdef0123456789xyz img"
        ],
        "allow": [
          "docker run -e DEBUG=1 img"
        ]
      }
    },
    {
      "id": "warn-curl-auth-literal",
      "level": "warn",
      "category": "secrets",
      "reversibility": "irreversible",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "curl\\s+.*-H\\s+[\"'](Authorization|X-API-Key|X-Auth-Token):\\s*(Bearer\\s+)?[A-Za-z0-9+/=._-]{16,}",
        "ci": false
      },
      "reason": "curl with literal token in Authorization header — leaks via history + transcript",
      "alt": "use $TOKEN sourced from dist/.secrets",
      "tests": {
        "deny": [
          "curl -H \"Authorization: Bearer abcdef0123456789xyz\" https://x"
        ],
        "allow": [
          "curl -H \"Authorization: Bearer $TOKEN\" https://x"
        ]
      }
    },
    {
      "id": "warn-export-literal",
      "level": "warn",
      "category": "secrets",
      "reversibility": "irreversible",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "(^|\\s|;|&&)\\s*export\\s+[A-Z][A-Z0-9_]*=[A-Za-z0-9+/=._-]{20,}",
        "ci": false
      },
      "reason": "export with long literal value looks like a hardcoded credential",
      "alt": "source dist/.secrets instead",
      "tests": {
        "deny": [
          "export API_TOKEN=abcdefghij0123456789xyz"
        ],
        "allow": [
          "export DEBUG=1"
        ]
      }
    },
    {
      "id": "warn-cat-secret",
      "level": "warn",
      "category": "secrets",
      "reversibility": "irreversible",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "(^|\\s|;|&&|\\|)\\s*(cat|less|bat|head|tail)\\s+[^|;]*(\\.secrets\\b|/\\.env\\b|\\.key\\b|\\.pem\\b|\\.age\\b)",
        "ci": false
      },
      "reason": "printing secret file to terminal leaks credentials into transcript/cache",
      "alt": "sops --extract for one key, or pipe into a process: source dist/.secrets",
      "tests": {
