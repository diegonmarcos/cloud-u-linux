    {
      "id": "warn-ssh-sysctl",
      "level": "warn",
      "category": "declarative-state",
      "reversibility": "recoverable",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "ssh\\s+\\S+\\s+.*\\bsysctl\\s+-w",
        "ci": false
      },
      "reason": "SSH sysctl -w is imperative",
      "alt": "add to nix config + build.sh ship",
      "tests": {
        "deny": [
          "ssh gcp-proxy 'sysctl -w net.ipv4.ip_forward=1'"
