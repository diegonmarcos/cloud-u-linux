{
  "_comment": "SINGLE SOURCE OF TRUTH for this plugin's hook rules. Consumed by hook-engine.sh (enforce), gen-hooks-doc.sh (docs), test-hooks.sh (fixtures). NEVER hand-edit deployed copy — edit here + build.sh switch. Owns the core engine: SessionStart principles injects + PreToolUse:Bash guard (allow|deny|warn) + PostToolUse nudge. Three independent axes: level (allow|deny|warn|nudge|inject) = reinforcement strength; category = protected asset/invariant; reversibility = blast radius.",
  "meta": {
    "version": 2,
    "nudge_threshold": 5,
    "nudge_count_tools": [
      "Read",
      "Grep",
      "Glob"
    ],
    "nudge_reset_prefix": "mcp__cloud-cgc"
  },
  "rules": [
    {
      "id": "inject-principles-compact-sessionstart",
      "level": "inject",
      "category": "read-only",
      "tiers": [
        "SessionStart"
      ],
      "fragment": "hooks-fragments/principles-compact.md",
      "reason": "Compact SessionStart summary (~950B) replacing 7 separate long fragments (~9.5KB combined: reference/core-principles/fire-rules/stack-philosophy/pre-action-checklist/forbidden-patterns/dead-shell-recovery). Originals left intact on disk for on-demand reading; see 'Full reference' line in the compact fragment."
    },
    {
      "id": "allow-npm-readonly",
      "level": "allow",
      "category": "read-only",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "^npm\\s+(root|config|prefix|ls|list|ll|la|view|info|show|search|help|explain|doctor|audit|outdated|fund|pack|ping|whoami|token|profile|access|bugs|repo|completion|explore|-v|--version|-h|--help)(\\s|$)",
        "ci": false
      },
      "reason": "read-only npm introspection — always allowed",
      "tests": {
        "allow": [
          "npm ls",
          "npm view react",
          "npm --version"
        ],
        "deny": []
      }
    },
    {
      "id": "allow-nix-readonly",
      "level": "allow",
      "category": "read-only",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "^nix\\s+(eval|show-derivation|path-info|log|why-depends|store|hash|doctor|registry|--version|--help|-h)(\\s|$)",
        "ci": false
      },
      "reason": "read-only nix introspection — always allowed",
      "tests": {
        "allow": [
          "nix eval .#foo",
          "nix store gc --version"
        ],
        "deny": []
      }
    },
    {
      "id": "allow-nix-flake-readonly",
      "level": "allow",
      "category": "read-only",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "^nix\\s+flake\\s+(show|check|info|metadata)(\\s|$)",
        "ci": false
      },
      "reason": "read-only nix flake introspection — always allowed",
      "tests": {
        "allow": [
          "nix flake show",
          "nix flake metadata"
        ],
        "deny": []
      }
    },
    {
      "id": "allow-nix-profile-list",
      "level": "allow",
      "category": "read-only",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "^nix\\s+profile\\s+list(\\s|$)",
        "ci": false
      },
      "reason": "read-only nix profile list — always allowed",
      "tests": {
        "allow": [
          "nix profile list"
        ],
        "deny": []
      }
    },
    {
      "id": "allow-docker-readonly",
      "level": "allow",
      "category": "read-only",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "^docker\\s+(ps|images|logs|inspect|top|stats|diff|port|version|info|events|history|search|-v|--version|-h|--help)(\\s|$)",
        "ci": false
      },
      "reason": "read-only docker introspection — always allowed",
      "tests": {
        "allow": [
          "docker ps",
          "docker logs web",
          "docker images"
        ],
        "deny": []
      }
    },
    {
      "id": "allow-docker-net-vol-readonly",
      "level": "allow",
      "category": "read-only",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "^docker\\s+(network|volume)\\s+(ls|inspect)(\\s|$)",
        "ci": false
      },
      "reason": "read-only docker network/volume introspection — always allowed",
      "tests": {
        "allow": [
          "docker volume ls",
          "docker network inspect bridge"
        ],
        "deny": []
      }
    },
    {
      "id": "allow-pip-readonly",
      "level": "allow",
      "category": "read-only",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "^pip3?\\s+(list|show|freeze|check|config|--version|-V|--help|-h)(\\s|$)",
        "ci": false
      },
      "reason": "read-only pip introspection — always allowed",
      "tests": {
        "allow": [
          "pip list",
          "pip3 show flask"
        ],
        "deny": []
      }
    },
    {
      "id": "git-add-force",
      "level": "deny",
      "category": "secrets",
      "reversibility": "irreversible",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "(^|[;&|])\\s*git\\s+(-[Cc]\\s+\\S+\\s+)?add\\b[^;&|]*\\s(-[A-Za-z]*f\\b|--force\\b)",
        "ci": false
      },
      "reason": "git add -f/--force bypasses gitignore — can stage decrypted secrets, private keys, sensitive/",
      "alt": "plain 'git add <path>'; if gitignore blocks a file, FIX gitignore — never force",
      "tests": {
        "deny": [
          "git add -f x.env",
          "git add x.env -f",
          "git add -A -f",
          "git add -Af",
          "git add --force x",
          "git -C /repo add secret.env -f"
        ],
        "allow": [
          "git add normalfile.txt",
          "git add -A",
          "git commit -m 'note: never git add -f here'"
        ]
      }
    },
    {
      "id": "docker-compose-down-volumes",
      "level": "deny",
      "category": "data-loss",
      "reversibility": "irreversible",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "docker(-compose|\\s+compose)\\b[^;&|]*\\sdown\\b[^;&|]*\\s(-v\\b|--volumes\\b)",
        "ci": true
      },
      "reason": "docker compose down -v wipes ALL named volumes (databases, state) — irreversible",
      "alt": "docker compose down (without -v) or build.sh compose",
      "tests": {
        "deny": [
          "docker compose down -v",
          "docker compose -f x.yml down -v",
          "docker compose -p proj down --volumes"
        ],
        "allow": [
          "docker compose down",
          "docker compose up -d"
        ]
      }
    },
    {
      "id": "docker-volume-rm-prune",
      "level": "deny",
      "category": "data-loss",
      "reversibility": "irreversible",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "docker\\s+volume\\s+(rm|prune)\\b",
        "ci": true
      },
      "reason": "docker volume rm/prune permanently deletes named volumes — irreversible",
      "alt": "manual cleanup only after explicit user confirmation; inspect with 'docker volume ls' first",
      "tests": {
        "deny": [
          "docker volume rm db",
          "docker volume prune"
        ],
        "allow": [
          "docker volume ls",
          "docker volume inspect db"
        ]
      }
    },
    {
      "id": "docker-system-prune-volumes",
      "level": "deny",
      "category": "data-loss",
      "reversibility": "irreversible",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "docker\\s+system\\s+prune\\s+.*--volumes\\b",
        "ci": true
      },
      "reason": "docker system prune --volumes wipes everything including databases",
      "alt": "targeted cleanup; inspect with 'docker system df' first",
      "tests": {
        "deny": [
          "docker system prune -a --volumes"
        ],
        "allow": [
          "docker system df",
          "docker system prune"
        ]
      }
    },
    {
      "id": "nix-env-install",
      "level": "deny",
      "category": "declarative-state",
      "reversibility": "recoverable",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "(^|\\s|;|&&|\\|)\\s*nix-env\\s+(-i|--install|-iA)\\b",
        "ci": false
      },
      "reason": "nix-env -i is imperative package management — pollutes the user profile and breaks declarative reproducibility",
      "alt": "add the package to flake.nix (home.packages or environment.systemPackages) + build.sh switch",
      "tests": {
        "deny": [
          "nix-env -i hello",
          "nix-env -iA nixpkgs.hello",
          "nix-env --install ripgrep"
        ],
        "allow": [
          "nix-env -q",
          "nix-env --list-generations"
        ]
      }
    },
    {
      "id": "secret-write-redirect",
      "level": "deny",
      "category": "secrets",
      "reversibility": "irreversible",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "(^|[;&|])\\s*(echo|printf)\\b[^|;]*>>?\\s*[^|;]*((^|/)\\.env([[:space:];|&]|$)|(^|/)\\.secrets([[:space:];|&]|$)|secrets\\.ya?ml([[:space:];|&]|$))",
        "ci": false
      },
      "reason": "imperative write (echo/printf >) to .secrets/.env/secrets.yaml bypasses sops",
      "alt": "edit src/secrets.yaml + build.sh secrets",
      "tests": {
        "deny": [
          "echo FOO=bar > app/.env",
          "printf 'x' >> dist/.secrets"
        ],
        "allow": [
          "echo hello > notes.txt",
          "echo FOO=bar > .secrets-hash"
        ]
      }
    },
    {
      "id": "secret-tee",
      "level": "deny",
      "category": "secrets",
      "reversibility": "irreversible",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "(^|[;&|])\\s*tee\\b[^|;]*\\s+[^|;]*((^|/)\\.env([[:space:];|&]|$)|(^|/)\\.secrets([[:space:];|&]|$)|secrets\\.ya?ml([[:space:];|&]|$))",
        "ci": false
      },
      "reason": "tee writing to .secrets/.env/secrets.yaml bypasses sops",
      "alt": "edit src/secrets.yaml + build.sh secrets",
      "tests": {
        "deny": [
          "tee app/.env",
          "tee -a dist/.secrets"
        ],
        "allow": [
          "tee notes.txt",
          "tee .secrets-hash-new"
        ]
      }
    },
    {
      "id": "git-add-secret",
      "level": "deny",
      "category": "secrets",
      "reversibility": "irreversible",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "(^|[;&|])\\s*git\\s+(-[Cc]\\s+\\S+\\s+)?add\\b[^;|&]*(\\.(env|key|pem|age|p12|pfx)([[:space:];|&]|$)|(^|/)\\.secrets([[:space:];|&]|$)|secrets\\.ya?ml([[:space:];|&]|$))",
        "ci": false
      },
      "handler": "check_git_add_secret",
      "reason": "git add of secret-shaped path — public-repo exposure risk",
      "alt": "sops-encrypt secrets.yaml first; raw key material lives only in ~/git/vault",
      "tests": {
        "deny": [],
        "allow": [
          "git add config.pem",
          "git add .env",
          "git add -A",
          "git add src/main.rs"
        ]
      }
    },
    {
      "id": "warn-rsync-delete",
      "level": "warn",
      "category": "data-loss",
      "reversibility": "irreversible",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "rsync\\s+.*--delete",
        "ci": true
      },
      "reason": "rsync --delete removes remote files not in source",
      "alt": "build.sh deploy",
      "tests": {
        "deny": [
          "rsync -a --delete src/ host:/dst/"
        ],
        "allow": [
          "rsync -a src/ host:/dst/"
        ]
      }
    },
    {
