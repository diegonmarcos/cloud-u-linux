      "match": {
        "pattern": "ssh\\s+\\S+\\s+.*\\b(echo|sed|tee|cat|printf)\\s.*>>?",
        "ci": false
      },
      "reason": "SSH write-redirect on a VM is imperative — declarative stack expects edit-source + build.sh ship",
      "alt": "edit source in git repo (src/) + build.sh ship",
      "tests": {
        "deny": [
          "ssh oci-apps 'echo x > /etc/foo'"
        ],
        "allow": [
