    {
      "id": "warn-sops-decrypt",
      "level": "warn",
      "category": "secrets",
      "reversibility": "advisory",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "(^|\\s|;|&&|\\|)\\s*sops\\s+(-d|--decrypt)\\b",
        "ci": false
      },
      "reason": "manual sops decrypt bypasses the engine",
      "alt": "build.sh secrets",
      "tests": {
        "deny": [
          "sops -d src/secrets.yaml"
        ],
        "allow": [
          "sops --version"
        ]
      }
    },
    {
      "id": "warn-sops-decrypt-inplace",
      "level": "warn",
      "category": "secrets",
      "reversibility": "recoverable",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "\\bsops\\s+(-d|--decrypt)\\s+(\\S+\\s+)*-i\\b|\\bsops\\s+-d\\s+-i\\b|\\bsops\\s+-i\\s+-d\\b",
        "ci": false
      },
      "reason": "sops -d -i leaves secrets.yaml plaintext on disk — easy accidental git add",
      "alt": "decrypt to stdout (sops -d file | …) or use build.sh secrets",
      "tests": {
        "deny": [
          "sops -d -i src/secrets.yaml"
        ],
        "allow": [
          "sops -e src/secrets.yaml"
        ]
      }
    },
    {
      "id": "warn-ssh-secret-redirect",
      "level": "warn",
      "category": "secrets",
