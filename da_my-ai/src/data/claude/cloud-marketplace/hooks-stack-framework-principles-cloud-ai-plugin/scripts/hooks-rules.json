    {
      "id": "git-branch-create",
      "level": "deny",
      "category": "workflow",
      "reversibility": "recoverable",
      "event": "PreToolUse:Bash",
      "match": {
        "pattern": "(^|[;&|])\\s*git\\s+(-[Cc]\\s+\\S+\\s+)?(checkout\\s+-b\\b|switch\\s+-[cC]\\b|branch\\s+[^-[:space:];&|]|worktree\\s+add\\b)",
        "ci": false
      },
      "reason": "BRANCHES ARE FORBIDDEN — this repo works ONLY on main (direct commit + push; GHA deploys on push). Never create or switch to a branch.",
      "alt": "stay on main: edit, commit, and push directly. No branches, no PRs.",
      "tests": {
        "deny": [
          "git checkout -b feature",
          "git switch -c wip",
          "git branch newthing",
          "git worktree add ../wt x"
        ],
        "allow": [
          "git branch",
          "git branch --format=%(refname:short)",
          "git branch -d old",
          "git branch -D old",
          "git checkout main",
          "git switch main",
          "git checkout -- file.txt"
        ]
      }
    }
  ]
