{
  "_description": "my-browser (qute) keybindings — SINGLE SoT for BOTH qutebrowser and the dashboard 'Shortcuts' reference tab. Shape: mode → key → { cmd, desc, group }. The home-module projects key→cmd into programs.qutebrowser.keyBindings.<mode>; gen-dashboard.sh reads key+desc+group to render the searchable Shortcuts panel. Edit HERE to change shortcuts — this is the 'Config-shortcuts' place. Command names verified against qutebrowser 3.5.1 (cmd-set-text, tab-*, reload, yank, session-load). These bindings are layered on top of qutebrowser defaults (recursiveUpdate); a key listed here overrides its default. Ctrl-Shift-{n,t,b} are injected by the home-module (default-window / open-saved-tabs / vaultwarden) and documented there.",
  "normal": {
    "<Tab>":        { "cmd": "tab-next", "desc": "Next tab", "group": "Tabs" },
    "<Shift-Tab>":  { "cmd": "tab-prev", "desc": "Previous tab", "group": "Tabs" },
    "t":            { "cmd": "cmd-set-text -s :open -t", "desc": "New tab → type address", "group": "Tabs" },
    "T":            { "cmd": "open -t about:blank", "desc": "New blank tab", "group": "Tabs" },
    "w":            { "cmd": "tab-close", "desc": "Close current tab", "group": "Tabs" },
    "W":            { "cmd": "tab-only", "desc": "Close all other tabs", "group": "Tabs" },
    "q":            { "cmd": "close", "desc": "Close window", "group": "Tabs" },
    "u":            { "cmd": "undo", "desc": "Reopen last closed tab", "group": "Tabs" },
    "<":            { "cmd": "tab-move -", "desc": "Move tab left", "group": "Tabs" },
    ">":            { "cmd": "tab-move +", "desc": "Move tab right", "group": "Tabs" },
    "<Ctrl-p>":     { "cmd": "tab-pin", "desc": "Pin / unpin tab", "group": "Tabs" },
    "<Ctrl-m>":     { "cmd": "tab-mute", "desc": "Mute / unmute tab", "group": "Tabs" },

    "H":            { "cmd": "back", "desc": "Back", "group": "Navigate" },
    "L":            { "cmd": "forward", "desc": "Forward", "group": "Navigate" },
    "<Alt-Left>":   { "cmd": "back", "desc": "Back (Alt-Left)", "group": "Navigate" },
    "<Alt-Right>":  { "cmd": "forward", "desc": "Forward (Alt-Right)", "group": "Navigate" },
    "<Alt-Up>":     { "cmd": "open file:///home/diego/.config/qutebrowser/qute-bookmarks.html", "desc": "Home (dashboard, Alt-Up)", "group": "Navigate" },
    "r":            { "cmd": "reload", "desc": "Reload", "group": "Navigate" },
    "R":            { "cmd": "reload -f", "desc": "Hard reload (bypass cache)", "group": "Navigate" },
    "<F5>":         { "cmd": "reload", "desc": "Reload", "group": "Navigate" },
    "<Escape>":     { "cmd": "stop", "desc": "Stop loading", "group": "Navigate" },
    "<F11>":        { "cmd": "fullscreen", "desc": "Toggle fullscreen", "group": "Navigate" },

    "o":            { "cmd": "cmd-set-text -s :open", "desc": "Open address (this tab)", "group": "URL / clipboard" },
    "O":            { "cmd": "cmd-set-text -s :open -t", "desc": "Open address (new tab)", "group": "URL / clipboard" },
    "e":            { "cmd": "cmd-set-text :open {url:pretty}", "desc": "Edit current URL", "group": "URL / clipboard" },
    "E":            { "cmd": "cmd-set-text :open -t {url:pretty}", "desc": "Edit current URL → new tab", "group": "URL / clipboard" },
    "Y":            { "cmd": "yank url", "desc": "Copy current URL", "group": "URL / clipboard" },
    "p":            { "cmd": "open -- {clipboard}", "desc": "Open clipboard URL (this tab)", "group": "URL / clipboard" },
    "P":            { "cmd": "open -t -- {clipboard}", "desc": "Open clipboard URL (new tab)", "group": "URL / clipboard" },

    "gD":           { "cmd": "open -t qute://downloads", "desc": "Downloads page", "group": "Pages / tools" },
    "<F12>":        { "cmd": "devtools", "desc": "Developer tools", "group": "Pages / tools" },
    "gI":           { "cmd": "open -t qute://history", "desc": "History page", "group": "Pages / tools" },
    "gS":           { "cmd": "open -t qute://settings", "desc": "Settings page", "group": "Pages / tools" },

    "<Ctrl-Shift-p>": { "cmd": "spawn --detach /home/diego/.local/bin/da_autofill-rbw-rofi pick", "desc": "Autofill: action picker", "group": "Autofill" },
    "<Ctrl-Shift-u>": { "cmd": "spawn --detach /home/diego/.local/bin/da_autofill-rbw-rofi user", "desc": "Autofill: username", "group": "Autofill" },
    "<Ctrl-Shift-l>": { "cmd": "spawn --detach /home/diego/.local/bin/da_autofill-rbw-rofi pass", "desc": "Autofill: password", "group": "Autofill" },
    "<Ctrl-Shift-o>": { "cmd": "spawn --detach /home/diego/.local/bin/da_autofill-rbw-rofi totp", "desc": "Autofill: TOTP", "group": "Autofill" },
    "_comment_autofill": "spawn --detach (NOT --userscript): da_autofill-rbw-rofi is a standalone GUI helper; the browser is just a focused window to it. Trailing arg pick|user|pass|totp selects the action.",

    ",d":           { "cmd": "open file:///home/diego/.config/qutebrowser/qute-bookmarks.html", "desc": "Open bookmarks (dashboard)", "group": "Leader" },
    ",s":           { "cmd": "config-shortcuts", "desc": "Open Shortcuts reference (Config-shortcuts)", "group": "Leader" },
    ",e":           { "cmd": "config-edit", "desc": "Edit config.py in $EDITOR (native qutebrowser command)", "group": "Leader" },
    ",v":           { "cmd": "open https://vault.diegonmarcos.com", "desc": "Vaultwarden", "group": "Leader" },
    ",a":           { "cmd": "open https://auth.diegonmarcos.com", "desc": "Authelia", "group": "Leader" },
    ",g":           { "cmd": "open https://git.diegonmarcos.com", "desc": "Gitea", "group": "Leader" }
  },
