{
  "images": {
    "deb-nix": "ghcr.io/diegonmarcos/user-dev-x86-deb-nix-hm:latest",
    "deb-apt": "ghcr.io/diegonmarcos/user-dev-x86-deb-apt:latest",
    "nixos-hm": "ghcr.io/diegonmarcos/user-dev-x86-nixos-nix-hm:latest"
  },
  "profiles": {
    "cli": {
      "interactive": true,
      "container_name": "diego-cli",
      "flags": "--privileged --network host --pid host",
      "podman_flags": "--privileged --network host",
      "env": {
        "TERM": "${TERM:-xterm-256color}"
      },
      "mounts": [
        "${HOME}:${HOME}",
        "/var/run/docker.sock:/var/run/docker.sock?socket",
        "/etc/wireguard:/etc/wireguard:ro?dir",
        "/opt:/opt?dir"
      ]
    },
    "gui": {
      "interactive": true,
      "container_name": "diego-gui",
      "flags": "--privileged --network host --pid host --ipc host --security-opt label=disable --security-opt apparmor=unconfined --pids-limit=-1 --ulimit host",
      "podman_flags": "--privileged --network host --pid host --ipc host --security-opt label=disable --security-opt apparmor=unconfined --pids-limit=-1 --ulimit host --userns keep-id",
      "env": {
        "TERM": "${TERM:-xterm-256color}",
        "DISPLAY": "${DISPLAY:-}",
        "WAYLAND_DISPLAY": "${WAYLAND_DISPLAY:-}",
        "XDG_RUNTIME_DIR": "${XDG_RUNTIME_DIR}",
        "DBUS_SESSION_BUS_ADDRESS": "${DBUS_SESSION_BUS_ADDRESS:-}",
        "PULSE_SERVER": "${PULSE_SERVER:-}",
        "SHELL": "fish"
      },
      "mounts": [
        "${HOME}:${HOME}:rslave",
        "/tmp:/tmp:rslave",
        "/dev:/dev:rslave",
        "/sys:/sys:rslave",
        "/dev/pts",
        "/dev/null:/dev/ptmx",
        "${XDG_RUNTIME_DIR}:${XDG_RUNTIME_DIR}:rslave?dir",
        "/var/run/docker.sock:/var/run/docker.sock?socket",
        "/etc/wireguard:/etc/wireguard:ro?dir",
        "/opt:/opt?dir",
        "/nix:/nix?dir",
        "/var/log/journal:/var/log/journal?dir",
        "/etc/hosts:/etc/hosts:ro",
        "/etc/resolv.conf:/etc/resolv.conf:ro",
        "/etc/hostname:/etc/hostname:ro"
      ]
    },
    "tty": {
      "interactive": false,
      "container_name": "diego-tty",
      "flags": "--privileged --network host --pid host",
      "podman_flags": "--privileged --network host --pid host",
      "env": {
        "TERM": "dumb"
      },
      "mounts": [
        "${HOME}:${HOME}",
        "/var/run/docker.sock:/var/run/docker.sock?socket",
        "/etc/wireguard:/etc/wireguard:ro?dir",
        "/opt:/opt?dir"
      ]
    }
  },
  "combinations": [
    { "id": 1, "image": "deb-nix", "profile": "cli", "label": "deb-nix-cli" },
    { "id": 2, "image": "deb-nix", "profile": "gui", "label": "deb-nix-gui" },
    { "id": 3, "image": "deb-nix", "profile": "tty", "label": "deb-nix-tty" },
    { "id": 4, "image": "deb-apt", "profile": "cli", "label": "deb-apt-cli" },
    { "id": 5, "image": "deb-apt", "profile": "gui", "label": "deb-apt-gui" },
    { "id": 6, "image": "deb-apt", "profile": "tty", "label": "deb-apt-tty" },
    { "id": 7, "image": "nixos-hm", "profile": "cli", "label": "nixos-hm-cli" },
    { "id": 8, "image": "nixos-hm", "profile": "gui", "label": "nixos-hm-gui" },
    { "id": 9, "image": "nixos-hm", "profile": "tty", "label": "nixos-hm-tty" }
  ],
  "path": "/home/${USER}/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/usr/local/bin:/usr/bin:/bin:/sbin"
}
