# Repo-level git config — deployed by 1_configs/build.sh
# Managed declaratively: edit src/gitconfig, run build.sh, commit.
[push]
	recurseSubmodules = on-demand
[submodule]
	recurse = true
[fetch]
	recurseSubmodules = on-demand
[core]
	hooksPath = 1_configs/dist/hooks
[pull]
	rebase = true
[rebase]
	autoStash = true
[alias]
	# smart, non-destructive sync — see 1_configs/src/gha/scripts/cloud-git-sync.sh
	#   git sync           → remote wins on conflict (default)
	#   git sync remote    → remote wins on conflict
	#   git sync local     → local commits win on conflict
	sync = !./1_configs/dist/scripts/cloud-git-sync.sh
	# bulletproof reset-from-origin — see 1_configs/src/gha/scripts/cloud-git-nuke.sh
	# DESTRUCTIVE: wipes local commits, dirty work, untracked files. Survives
	# force-pushes and divergent history. For ephemeral CI containers.
	#   git nuke           → reset to origin/<current-branch>
	#   git nuke main      → reset to origin/main explicitly
	nuke = !./1_configs/dist/scripts/cloud-git-nuke.sh
