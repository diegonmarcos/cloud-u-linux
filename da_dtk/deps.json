{
  "_meta": {
    "description": "DTK runtime dependencies — checked by 51g deps-solver",
    "categories": "required = DTK won't function, recommended = full experience, optional = specific features"
  },
  "required": {
    "sh": "POSIX shell",
    "jq": "JSON processing (menu, aliases, tools)",
    "column": "table alignment (menu display)",
    "awk": "text processing (system info, aliases)",
    "sed": "text substitution",
    "git": "version control, git clone, refresh",
    "ssh": "remote VM access (21a-f, quick-cmds)",
    "curl": "HTTP client (webhooks, API calls)",
    "free": "memory info (system info table)",
    "df": "disk info (system info table)",
    "ip": "network info (wg0, local IP)",
    "ps": "process count (system info)",
    "who": "user count (system info)",
    "date": "timestamps (logging)",
    "tee": "logging (stdout + log file)",
    "wc": "counting (containers, ports)"
  },
  "recommended": {
    "tmux": "dashboards (30-36), batch-htop, journal-dash",
    "docker": "container management (quick-cmds, docker-stats)",
    "btop": "local monitor (30a)",
    "fish": "shell setup (42a/b)",
    "ss": "listening ports (sys-net-resource)",
    "journalctl": "journal dashboards (32a-d)",
    "systemctl": "service management (quick-cmds)",
    "nix": "package management (setups, builds)",
    "home-manager": "NixOS user config (desktop flake)",
    "watch": "watch mode (32d watch-n35)"
  },
  "optional": {
    "iotop": "IO monitor (30b) — needs sudo",
    "iostat": "sysstat IO stats (31a)",
    "mpstat": "sysstat CPU stats (31b)",
    "pidstat": "sysstat process stats (31c)",
    "sar": "sysstat system activity (31d)",
    "gh": "GitHub CLI (vps gh-actions/repos/registry)",
    "gcloud": "Google Cloud CLI (vps cloud)",
    "oci": "Oracle Cloud CLI (vps cloud)",
    "terraform": "infrastructure (engines)",
    "sops": "secrets decryption",
    "age": "encryption (sops backend)"
  }
}
