    { "name": "cpucap",  "file": "cpucap.fish",  "group": "sys", "desc": "cap CPU frequency / governor" },

    { "name": "plasmashell", "file": "plasmashell.fish", "group": "session", "desc": "start|stop|restart (default restart) the Plasma shell" },

    { "name": "serve",       "file": "serve.fish",       "group": "dev", "desc": "static HTTP server in this folder" },
