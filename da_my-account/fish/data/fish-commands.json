    { "name": "qfind",   "file": "qfind.fish",   "group": "nav", "desc": "quick find by name" },
    { "name": "extract", "file": "extract.fish", "group": "nav", "desc": "extract any archive by extension" },
    { "name": "backup",  "file": "backup.fish",  "group": "nav", "desc": "timestamped copy of a file" },

    { "name": "duh",     "file": "duh.fish",     "group": "sys", "desc": "disk usage here, sorted" },
