{
  "_comment": "Registry of Claude Code PLUGINS (NOT MCP servers) surfaced in the status bar (PL[...]) and the claude-superset banner. Data-driven: add a plugin by appending an entry here \u2014 the engine (claude-plugins-status.sh) needs NO edits. Detection is intentionally cheap (env var / flag file) so it runs in the statusline hot path with zero spawns.",
  "plugins": [
    {
      "id": "headroom",
      "label": "Headroom",
      "icon": "H",
      "detect": {
        "type": "env_set",
        "env": "ANTHROPIC_BASE_URL"
      },
      "group": "Sys"
    },
    {
      "id": "ponytail",
      "label": "Ponytail",
      "icon": "P",
      "detect": {
        "type": "flag_file",
        "path": ".ponytail-active",
        "show_content": true
      },
      "group": "Sys"
    },
    {
      "id": "rtk",
      "label": "RTK",
      "icon": "R",
      "detect": {
        "type": "env_set",
        "env": "RTK_ENABLED"
      },
      "group": "Sys"
    },
    {
      "id": "caveman",
      "label": "Caveman",
      "icon": "C",
      "detect": {
        "type": "env_set",
        "env": "CAVEMAN_ENABLED"
      },
      "group": "Sys"
    },
    {
      "id": "superset-mode",
      "label": "M",
      "icon": "M",
      "detect": {
        "type": "env_value",
        "env": "CLAUDE_SUPERSET_MODE"
      }
    }
  ]
}