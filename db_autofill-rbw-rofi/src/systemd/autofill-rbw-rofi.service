[Unit]
Description=System-wide hotkey password autofill (rbw + rofi/wofi + wtype/xdotool)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/da_autofill-rbw-rofi
# RUST_LOG=info by default; override with `systemctl --user edit ...`
Environment=RUST_LOG=info
# Hard memory cap — typing flow allocates very little
MemoryMax=64M
# Be polite to the rest of the desktop
Nice=5
# Failures should surface, not be retried silently
Restart=no
TimeoutStartSec=30s

[Install]
WantedBy=default.target
