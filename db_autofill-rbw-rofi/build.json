{
  "project": {
    "name": "da_autofill-rbw-rofi",
    "version": "0.1.0",
    "description": "System-wide hotkey password autofill (browsers AND any other window): rbw + rofi/wofi picker → wtype/xdotool keystroke synthesis. Replaces the Bitwarden browser extension's autofill path; works in terminals, ssh prompts, KeePassXC unlock, native apps, and browsers."
  },
  "paths": {
    "src": "src",
    "rust_crate": "src",
    "dist": "dist",
    "systemd_unit": "src/systemd/da_autofill-rbw-rofi.service",
    "log": "build.log"
  },
  "build": {
    "language": "rust",
    "edition": "2021",
    "binary_name": "da_autofill-rbw-rofi",
    "via_nix_flake": true,
    "flake_path": "src/flake.nix"
  },
  "runtime": {
    "user_unit": true,
    "user_unit_name": "da_autofill-rbw-rofi.service",
    "picker": {
      "wayland": "wofi --dmenu --prompt Vault",
      "x11":     "rofi -dmenu -p Vault"
    },
    "typer": {
      "wayland": "wtype",
      "x11":     "xdotool type --clearmodifiers"
    },
    "clipboard": {
      "wayland": "wl-copy",
      "x11":     "xclip -selection clipboard -in"
    },
    "notifier": "notify-send",
    "rbw": {
      "list_cmd":   "rbw list --fields name,user",
      "get_cmd":    "rbw get",
      "user_field": "--field user",
      "totp_cmd":   "rbw code",
      "timeout_secs": 5
    },
    "actions": ["user", "pass", "totp", "user_tab_pass"],
    "default_action": "user_tab_pass",
    "totp_to_clipboard_seconds": 20,
    "slow_typing_env_var": "DA_AUTOFILL_RBW_ROFI_SLOW",
    "slow_typing_delay_ms": 8
  }
}
