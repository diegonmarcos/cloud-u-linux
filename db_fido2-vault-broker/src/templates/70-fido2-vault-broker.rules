# udev rules for fido2-vault-broker.
#
# Two devices the daemon needs:
#   1. /dev/uhid  — virtual FIDO2 HID device (registered by the daemon).
#   2. /dev/tpmrm0 — TPM2 resource manager (used to seal/unseal the master
#      vault password under PCR-bound policy when `--features tpm` is on).
#
# tpm2-tss does NOT ship its own udev rules and NixOS `security.tpm2.enable`
# only creates the `tss` group without granting group access — without this
# rule, /dev/tpmrm0 stays root-only and the daemon falls back to the mock
# AES-GCM seal backend (PoC-only). With this rule + group membership, the
# real TPM2 path activates.
#
# This file is packaged into the derivation by flake.nix postInstall and
# installed automatically by `services.udev.packages = [ cfg.package ]`.

KERNEL=="uhid",   GROUP="uhid", MODE="0660", TAG+="uaccess"
KERNEL=="tpm0",   GROUP="tss",  MODE="0660"
KERNEL=="tpmrm0", GROUP="tss",  MODE="0660"
