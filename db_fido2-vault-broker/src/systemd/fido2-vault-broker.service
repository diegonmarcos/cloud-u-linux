[Unit]
Description=FIDO2 vault broker — virtual FIDO2 authenticator backed by Bitwarden/Vaultwarden
After=graphical-session.target
# ConditionPathExists=/dev/uhid    # Enable in Phase B.4 when uhid wired up

[Service]
# Type=simple: daemon does not call sd_notify(READY=1).
Type=simple
ExecStart=%h/.local/bin/fido2-vault-broker run
Restart=on-failure
RestartSec=5
MemoryMax=64M
NoNewPrivileges=true
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
