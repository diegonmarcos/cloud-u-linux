{
  "order": 18,
  "name": "clipboard",
  "display_name": "Clipboard",
  "menu": "Others",
  "theme": { "accent": "#e17055" },
  "sections": [
    {
      "title": "Read / write",
      "items": [
        { "label": "Show clipboard", "cmd": "wl-paste 2>/dev/null || xclip -o -selection clipboard" },
        { "label": "Show primary", "cmd": "wl-paste -p 2>/dev/null || xclip -o -selection primary" },
        { "label": "Clear", "cmd": "wl-copy --clear 2>/dev/null || printf '' | xclip -selection clipboard" },
        { "label": "Copy stdin", "cmd": "wl-copy " }
      ]
    },
    {
      "title": "History (klipper)",
      "items": [
        { "label": "Klipper history", "cmd": "qdbus org.kde.klipper /klipper getClipboardHistoryMenu" },
        { "label": "Klipper contents", "cmd": "qdbus org.kde.klipper /klipper getClipboardContents" },
        { "label": "Clear history", "cmd": "qdbus org.kde.klipper /klipper clearClipboardHistory" }
      ]
    }
  ],
  "group": "g4"
}
