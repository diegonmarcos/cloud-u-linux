{
  "order": 16,
  "name": "hibernation",
  "display_name": "Hibernation",
  "menu": "Unix-Dev",
  "theme": { "accent": "#74b9ff" },
  "sections": [
    {
      "title": "State",
      "items": [
        { "label": "Swap", "cmd": "swapon --show; free -h" },
        { "label": "Resume offset", "cmd": "cat /sys/power/resume /sys/power/resume_offset 2>/dev/null" },
        { "label": "Sleep states", "cmd": "cat /sys/power/state /sys/power/mem_sleep" },
        { "label": "Suspend/resume log", "cmd": "journalctl -b -u systemd-suspend.service -u systemd-hibernate.service --no-pager" }
      ]
    },
    {
      "title": "Inhibitors",
      "items": [
        { "label": "List inhibitors", "cmd": "systemd-inhibit --list" },
        { "label": "Idle/lid settings", "cmd": "grep -v '^#' /etc/systemd/logind.conf | grep ." }
      ]
    }
  ],
  "group": "g3"
}
