{
  "order": 6,
  "name": "data-sync",
  "menu": "Data",
  "display_name": "Data Sync",
  "theme": {
    "accent": "#27ae60"
  },
  "sections": [
    {
      "title": "rsync — local",
      "items": [
        {
          "label": "Copy (archive+progress)",
          "cmd": "rsync -avh --progress SRC/ DST/"
        },
        {
          "label": "Mirror (--delete)",
          "cmd": "rsync -avh --delete --progress SRC/ DST/"
        },
        {
          "label": "Dry run (preview)",
          "cmd": "rsync -avhn --delete SRC/ DST/"
        },
        {
          "label": "Resume large files",
          "cmd": "rsync -avh --partial --progress --append-verify SRC/ DST/"
        },
        {
          "label": "Exclude .git/node_modules",
          "cmd": "rsync -avh --exclude '.git' --exclude 'node_modules' SRC/ DST/"
        }
      ]
    },
    {
      "title": "rsync — over SSH (fleet)",
      "items": [
        {
          "label": "Push → oci-apps",
          "cmd": "rsync -avhz --progress -e ssh SRC/ oci-apps:DST/"
        },
        {
          "label": "Pull ← oci-apps",
          "cmd": "rsync -avhz --progress -e ssh oci-apps:SRC/ DST/"
        },
        {
          "label": "Push → oci-mail",
          "cmd": "rsync -avhz --progress -e ssh SRC/ oci-mail:DST/"
        },
        {
          "label": "Push → oci-analytics",
          "cmd": "rsync -avhz --progress -e ssh SRC/ oci-analytics:DST/"
        },
        {
          "label": "Push → gcp-proxy",
          "cmd": "rsync -avhz --progress -e ssh SRC/ gcp-proxy:DST/"
        }
      ]
    },
    {
      "title": "rclone",
      "items": [
        {
          "label": "List remotes",
          "cmd": "rclone listremotes"
        },
        {
          "label": "Config (TUI)",
          "cmd": "rclone config"
        },
        {
          "label": "Sync local → remote",
          "cmd": "rclone sync SRC REMOTE:PATH -P"
        },
        {
          "label": "Copy (no delete)",
          "cmd": "rclone copy SRC REMOTE:PATH -P"
        },
        {
          "label": "Bisync (two-way)",
          "cmd": "rclone bisync SRC REMOTE:PATH -P"
        },
        {
          "label": "ls remote",
          "cmd": "rclone ls REMOTE:PATH"
        },
        {
          "label": "ncdu remote (disk usage)",
          "cmd": "rclone ncdu REMOTE:PATH"
        },
        {
          "label": "Check (verify)",
          "cmd": "rclone check SRC REMOTE:PATH"
        },
        {
          "label": "Dedupe",
          "cmd": "rclone dedupe REMOTE:PATH"
        }
      ]
    },
    {
      "title": "rclone — mount",
      "items": [
        {
          "label": "Mount remote → ~/mnt/rclone",
          "cmd": "mkdir -p ~/mnt/rclone && rclone mount REMOTE:PATH ~/mnt/rclone --vfs-cache-mode writes &"
        },
        {
          "label": "Unmount",
          "cmd": "fusermount -u ~/mnt/rclone"
        }
      ]
    },
    {
      "title": "SSHFS — remote volumes",
      "items": [
        {
          "label": "Mount oci-apps → ~/mnt/oci-apps",
          "cmd": "mkdir -p ~/mnt/oci-apps && sshfs oci-apps:/ ~/mnt/oci-apps -o reconnect,idmap=user"
        },
        {
          "label": "Mount oci-mail",
          "cmd": "mkdir -p ~/mnt/oci-mail && sshfs oci-mail:/ ~/mnt/oci-mail -o reconnect,idmap=user"
        },
        {
          "label": "Mount oci-analytics",
          "cmd": "mkdir -p ~/mnt/oci-analytics && sshfs oci-analytics:/ ~/mnt/oci-analytics -o reconnect,idmap=user"
        },
        {
          "label": "Mount gcp-proxy",
          "cmd": "mkdir -p ~/mnt/gcp-proxy && sshfs gcp-proxy:/ ~/mnt/gcp-proxy -o reconnect,idmap=user"
        },
        {
          "label": "Unmount (pick dir)",
          "cmd": "fusermount -u ~/mnt/oci-apps"
        },
        {
          "label": "List fuse mounts",
          "cmd": "mount | grep -E 'fuse|sshfs'"
        }
      ]
    },
    {
      "title": "Local volumes",
      "items": [
        {
          "label": "Block devices (lsblk)",
          "cmd": "lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT"
        },
        {
          "label": "Mounted filesystems",
          "cmd": "findmnt -t ext4,btrfs,vfat,ntfs"
        },
        {
          "label": "Disk usage",
          "cmd": "df -hT -x tmpfs -x devtmpfs"
        },
        {
          "label": "UUIDs / labels",
          "cmd": "blkid"
        },
        {
          "label": "Mount Shared-Lib (p5)",
          "cmd": "sudo mount -L Shared-Lib /mnt/shared-lib"
        },
        {
          "label": "Biggest dirs here (du)",
          "cmd": "du -xh --max-depth=1 . | sort -rh | head -20"
        },
        {
          "label": "ncdu (interactive)",
          "cmd": "ncdu ."
        }
      ]
    },
    {
      "title": "Syncthing",
      "items": [
        {
          "label": "Status",
          "cmd": "systemctl --user status syncthing"
        },
        {
          "label": "Open Web UI",
          "cmd": "xdg-open http://127.0.0.1:8384"
        }
      ]
    }
  ],
  "configs": [
    {
      "title": "rclone",
      "paths": ["~/.config/rclone/rclone.conf"]
    },
    {
      "title": "Syncthing",
      "paths": ["~/.local/state/syncthing/config.xml"]
    }
  ],
  "group": "g2"
}
