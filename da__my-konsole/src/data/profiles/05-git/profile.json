          "cmd": "gh release list"
        },
        {
          "label": "repo status all",
          "cmd": "gh repo list diegonmarcos"
        }
      ]
    },
    {
      "title": "GITHUB ACTIONS",
      "items": [
        {
          "label": "workflow list",
          "cmd": "gh workflow list"
        },
        {
          "label": "run watch",
          "cmd": "gh run watch"
        },
        {
