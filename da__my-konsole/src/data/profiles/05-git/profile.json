        {
          "label": "runs (cloud)",
          "cmd": "gh run list -R diegonmarcos/cloud-infra -L 15"
        },
        {
          "label": "runs (unix)",
          "cmd": "gh run list -R diegonmarcos/cloud-unix -L 15"
        },
        {
          "label": "runs (front)",
          "cmd": "gh run list -R diegonmarcos/front -L 15"
        }
      ]
    },
    {
      "title": "GHCR REGISTRY",
      "items": [
        {
          "label": "list packages",
          "cmd": "gh api /user/packages?package_type=container --jq '.[].name'"
        },
        {
          "label": "pull image (vm-pilot)",
          "cmd": "docker pull ghcr.io/diegonmarcos/vm-pilot:latest"
        },
        {
          "label": "package versions",
          "cmd": "bash ~/git/cloud-mykonsole-dtk/dtk.sh fleet.gh-registry"
        }
      ]
    }
  ],
