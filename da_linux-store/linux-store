#!/bin/sh
# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ linux-store — a nix-store equivalent for the Linux userlands             ║
# ║                                                                          ║
# ║ Usage: linux-store <command> [args]       (linux-store help)             ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
# Two profiles, never mixed: `termux` (the proot Debian on the phone) and
# `desktop`. cloud-store is the ANDROID engine (MyTerminal's link farm); this is
# its Linux sibling and shares no code with it on purpose — it may rely on GNU
# coreutils, util-linux and real symlinks, and does.
#
# Three layers, one generation:
#   bin/   what goes on PATH        — host binaries, store objects, or wrappers
#   lib/   .so files + script libs  — never exported globally; a bin entry that
#                                     needs them gets a wrapper (makeWrapper)
#   etc/   config mirrored into $HOME — $HOME/<rel> -> current/etc/<rel>
# plus `activate`: files Claude Code et al. rewrite at runtime, so they are
# WRITTEN (rendered whole, or patched key by key), never linked,
# and `secret`: SSH keys, tokens — decrypted with sops at realise time on THIS
# machine with the user's own age key (SOPS_AGE_KEY_FILE), written 0600 straight
# into $HOME. A secret value never enters store/, a manifest or a log line; the
# generation records only WHERE it comes from, and a 0600 state file its sha256.
#
# Semantics are nix's:
#   store/<hash>-<name>   immutable, content-addressed, shared by both profiles
#   generations/<p>-<n>   a complete link tree + manifest.json, sealed by rename
#   current               ONE symlink, switched with one rename(2) (mv -T)
#   rollback / switch     flip `current`, re-realise $HOME, no rebuild
#   gc                    drop every store object no kept generation references
#
# Sources of a store object:
#   path   a file/dir in a repo (relative to the git base, or "<root>:<rest>")
#   fetch  a URL with a fixed sha256 — refused on mismatch
#   host   a binary the host provides (apt, nix, cargo): linked, never copied
#
# Fault injection: LINUX_STORE_FAULT=<populate|seal|switch|activate> stops the
# run at that stage, so test/test-linux-store.sh can PROVE that `current` never
# points at a half-built generation.
set -u

ME=linux-store

die()  { printf '%s: %s\n' "$ME" "$*" >&2; exit 1; }
say()  { printf '%s: %s\n' "$ME" "$*"; }
fail() { printf '%s: FAIL — %s\n' "$ME" "$*" >&2; BAD=1; }

fault() {
    [ "${LINUX_STORE_FAULT:-}" = "$1" ] || return 0
    printf '%s: fault injected at stage %s — stopping\n' "$ME" "$1" >&2
    exit 90
}

# ── strict: Linux, GNU, and the tools the semantics depend on ──────────────
[ "$(uname -s)" = Linux ] || die "Linux only (this is $(uname -s)); the Android app terminal uses cloud-store"
for _c in jq sha256sum flock find mv readlink cmp; do
    command -v "$_c" >/dev/null 2>&1 || die "requires $_c on PATH"
done
find / -maxdepth 0 -printf '' 2>/dev/null || die "requires GNU find (-printf)"
mv --help 2>&1 | grep -q -- '--no-target-directory' \
    || die "requires GNU mv: the switch is mv -T, and there is no non-atomic fallback"

SELF="$(readlink -f "$0")"
HERE="$(dirname "$SELF")"

ROOT="${LINUX_STORE_ROOT:-$HOME/.linux-store}"
STORE="$ROOT/store"
GENS="$ROOT/generations"
CUR="$ROOT/current"
DEVLIST="$ROOT/dev.list"

# The git base: where the checkouts live. The phone keeps them on the
# CloudDrive mount, the desktop under ~/git. Needed BEFORE the declaration,
# because the declaration itself lives in a checkout (cloud-me_configs).
git_base() {
    if [ -n "${GIT_BASE:-}" ]; then
        [ -d "$GIT_BASE" ] || die "GIT_BASE=$GIT_BASE is not a directory (set by the environment — on the phone ~/.claude/settings.json env must point it at the CloudDrive mount)"
        echo "$GIT_BASE"; return 0
    fi
    for _c in "$HOME/git" "$HOME/cloud-drive-shared-store/git"; do
        if [ -d "$_c" ]; then echo "$_c"; return 0; fi
    done
    die "no git base: set GIT_BASE (looked in ~/git and ~/cloud-drive-shared-store/git)"
}

# The declaration is CONFIG, so it lives with the rest of the user's config in
# cloud-me_configs — not beside the engine. configs.json binds the user id to
# its directory; a non-nix user's linux-store declaration is
#   <user path>/deb-user-configs/linux-store.json
# LINUX_STORE_USER picks the configs-user (default diego-admin).
#
# Order: explicit override, else cloud-me_configs, else the path the last apply
# recorded (so `linux-store verify` still works with the checkout unmounted).
configs_decl() {
    local cfg u up
    cfg="$(git_base 2>/dev/null)/cloud-me_configs"
    [ -f "$cfg/configs.json" ] || return 1
    u="${LINUX_STORE_USER:-diego-admin}"
    up="$(jq -r --arg u "$u" '.configs_users[]? | select(.id == $u) | .path // empty' "$cfg/configs.json")"
    [ -n "$up" ] || die "$cfg/configs.json declares no configs-user '$u'"
    echo "$cfg/$up/deb-user-configs/linux-store.json"
}

if [ -n "${LINUX_STORE_DECLARATION:-}" ]; then
    DECL="$LINUX_STORE_DECLARATION"
elif DECL="$(configs_decl)" && [ -f "$DECL" ]; then
    :
elif [ -f "$ROOT/declaration" ]; then
    DECL="$(cat "$ROOT/declaration")"
fi
DECL="${DECL:-}"

need_decl() {
    [ -n "$DECL" ] && [ -r "$DECL" ] || die "no declaration: expected cloud-me_configs/<configs-user>/deb-user-configs/linux-store.json (or set LINUX_STORE_DECLARATION)"
    jq -e 'type == "object"' "$DECL" >/dev/null 2>&1 || die "$DECL is not a JSON object"
    _bad="$(jq -r '
        ( keys[] | select(startswith("_") | not)
                 | select(IN("settings","common","termux","desktop") | not)
                 | "unknown top-level key \"\(.)\"" ),
        ( ["common","termux","desktop"][] as $s | (.[$s] // {}) | keys[]
                 | select(startswith("_") | not)
                 | select(IN("bin","lib","etc","activate","secret") | not)
                 | "unknown layer \"\(.)\" in \($s)" )
    ' "$DECL")"
    [ -z "$_bad" ] || die "$DECL: $_bad"
    _bad="$(jq -r '.settings.include[]? // empty | select(type != "string") | "settings.include entries must be strings"' "$DECL")"
    [ -z "$_bad" ] || die "$DECL: $_bad"
}

# ── profile ────────────────────────────────────────────────────────────────
detect_profile() {
    if [ -n "${LINUX_STORE_PROFILE:-}" ]; then
        _p="$LINUX_STORE_PROFILE"
    else
        case "$(uname -r)" in
            *[Aa]ndroid*) _p=termux ;;
            *)
                _p=desktop
                [ -z "${TERMUX_VERSION:-}" ] || _p=termux
                case "${PREFIX:-}" in *com.termux*) _p=termux ;; esac
                ;;
        esac
    fi
    case "$_p" in
        termux|desktop) echo "$_p" ;;
        *) die "profile '$_p' is neither termux nor desktop" ;;
    esac
}

# ── sources ────────────────────────────────────────────────────────────────
# "/abs" | "<root>:<rest>" | "relative/to/git/base"
resolve_src() {
    local s="$1" root rest rp
    case "$s" in
        /*) echo "$s" ;;
        *:*)
            root="${s%%:*}"; rest="${s#*:}"
            rp="$(jq -r --arg r "$root" '.settings.roots[$r] // empty' "${RESOLVE_DECL:-$DECL}")"
            [ -n "$rp" ] || die "'$s' names root '$root', which settings.roots does not declare"
            rp="$(resolve_src "$rp")" || exit 1
            echo "$rp/$rest"
            ;;
        *) echo "$GB/$s" ;;
    esac
}

# A host binary, found WITHOUT our own bin/ on PATH (it would find itself), and
# resolved through every link so the generation records what actually runs.
resolve_host() {
    local h="$1" p
    case "$h" in
        /*) p="$h" ;;
        *)
            p="$(PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vFx "$CUR/bin" | paste -sd: -)" \
                 command -v "$h" 2>/dev/null)" || return 1
            ;;
    esac
    [ -e "$p" ] || return 1
    readlink -f "$p"
}

# ── the store ──────────────────────────────────────────────────────────────
# Content hash. Covers names, types, the executable bit, link targets and
# bytes — not other mode bits (a sealed object is a-w; it is the same object).
hash_path() {
    if [ -d "$1" ] && [ ! -L "$1" ]; then
        ( cd "$1" && {
            find . -mindepth 1 -printf '%y %P\n' | LC_ALL=C sort
            find . -type f -perm -u=x -printf 'x %P\n' | LC_ALL=C sort
            find . -type l -printf 'l %P %l\n' | LC_ALL=C sort
            find . -type f -print0 | LC_ALL=C sort -z | xargs -0 -r sha256sum
        } ) | sha256sum | cut -d' ' -f1
    else
        { if [ -x "$1" ]; then echo 'f x'; else echo 'f'; fi; cat "$1"; } | sha256sum | cut -d' ' -f1
    fi
}

seal()   { chmod -R a-w "$1" 2>/dev/null || true; }
unseal() { chmod -R u+w "$1" 2>/dev/null || true; }

# add_store <staged path> <name>  →  sets OBJ, OBJ_HASH
# The staged copy is hashed AFTER normalisation (exe), so verify re-derives the
# same hash from the sealed object. An existing object is reused only if it
# still hashes to its name; one edited in place is replaced, not trusted.
add_store() {
    local staged="$1" name h dest
    name="$(basename "$2" | sed 's/^\.//')"
    h="$(hash_path "$staged")"
    dest="$STORE/$(printf '%s' "$h" | cut -c1-32)-$name"
    if [ -e "$dest" ] || [ -L "$dest" ]; then
        if [ "$(hash_path "$dest")" = "$h" ]; then
            unseal "$staged"; rm -rf "$staged"
        else
            say "store object $dest no longer matches its hash — replacing it"
            unseal "$dest"; rm -rf "$dest"
            mv -T "$staged" "$dest" || die "could not place $dest"
            seal "$dest"
        fi
    else
        mv -T "$staged" "$dest" || die "could not place $dest"
        seal "$dest"
    fi
    echo "$dest" >> "$STAGE/.objects"
    OBJ="$dest"; OBJ_HASH="$h"
}

stage_tmp() { _n=$((_n + 1)); TMPP="$OBJTMP/$_n"; }

# ── build: declaration → sealed generation (no switch) ─────────────────────
# The effective declaration: the main file deep-merged with settings.include
# fragments (each a path like any source), later wins, null removes — the same
# overlay rules the profiles use. linux-account writes such a fragment.
# After the merge, roots declared by a fragment resolve too (RESOLVE_DECL).
merged_decl() {
    local inc files=""
    RESOLVE_DECL="$DECL"
    for inc in $(jq -r '.settings.include[]? // empty' "$DECL"); do
        inc="$(resolve_src "$inc")" || exit 1
        [ -f "$inc" ] || die "settings.include: $inc does not exist"
        jq -e 'type == "object"' "$inc" >/dev/null 2>&1 || die "settings.include: $inc is not a JSON object"
        files="$files $inc"
    done
    # shellcheck disable=SC2086
    jq -s 'reduce .[] as $x ({}; . * $x)' "$DECL" $files > "$ROOT/.merged.$$" || die "could not merge the declaration"
    RESOLVE_DECL="$ROOT/.merged.$$"
    cat "$ROOT/.merged.$$"
}

plan() {
    # merged_decl runs HERE, not in a pipeline, so RESOLVE_DECL survives for
    # the resolve_src calls that follow in build_entry.
    merged_decl >/dev/null
    jq -c --arg p "$1" '
        def ents($d; $l):
            ((($d.common // {})[$l] // {}) + (($d[$p] // {})[$l] // {}))
            | to_entries[]
            | select(.key | startswith("_") | not)
            | select(.value != null);
        . as $d
        | ( ["lib","etc","bin","secret"][] as $l | ents($d; $l) | {l: $l, k: .key, v: .value} ),
          ( ( (($d.common // {}).activate // {} | keys)
            + (($d[$p] // {}).activate // {} | keys) )
            | unique[] | select(startswith("_") | not) ) as $k
          | (($d.common // {}).activate // {})[$k] as $c
          | (($d[$p] // {}).activate // {})[$k] as $o
          | select($o != null or ($c != null and (($d[$p] // {}).activate // {} | has($k) | not)))
          | ($c // {}) as $c | ($o // {}) as $o
          | { l: "activate", k: $k,
              v: ( $c + $o
                   + (if ($c.render != null or $o.render != null)
                      then {render: (($c.render // []) + ($o.render // []))} else {} end) ) }
    ' "$RESOLVE_DECL"
}

entry() {  # layer name kind target source host app
    jq -nc --arg l "$1" --arg k "$2" --arg kind "$3" --arg t "$4" --arg s "$5" --arg h "${6:-}" --arg a "${7:-}" \
        '{layer:$l, name:$k, kind:$kind, target:$t, source:$s, host:$h, app:$a}' >> "$STAGE/.entries"
}

genlink() {  # target  layer  rel
    mkdir -p "$(dirname "$STAGE/$2/$3")"
    ln -s "$1" "$STAGE/$2/$3" || die "could not link $2/$3"
}

build_entry() {
    local line="$1" l k v nk host path url src t kind tmp sha sub opt app
    l="$(printf '%s' "$line" | jq -r .l)"
    k="$(printf '%s' "$line" | jq -r .k)"
    v="$(printf '%s' "$line" | jq -c .v)"
    case "$k" in
        ''|/*|*..*) die "$l/$k: names are relative and may not contain '..'" ;;
    esac
    case "$l" in
        bin|lib) case "$k" in */*) die "$l/$k: $l names are flat (no '/')" ;; esac ;;
    esac

    if [ "$l" = activate ]; then build_activate "$k" "$v"; return; fi
    if [ "$l" = secret ];   then build_secret "$k" "$v"; return; fi

    nk="$(printf '%s' "$v" | jq '[has("host"), has("path"), has("fetch")] | map(select(.)) | length')"
    [ "$nk" = 1 ] || die "$l/$k: declare exactly one of host, path, fetch"
    host="$(printf '%s' "$v" | jq -r '.host // empty')"
    path="$(printf '%s' "$v" | jq -r '.path // empty')"
    url="$(printf '%s' "$v" | jq -r '.fetch // empty')"

    # optional: declared now, present later (an app not yet built or fetched on
    # this box). An absent source is recorded as kind "absent" — the UI shows
    # it as declared · absent — instead of failing the whole switch.
    opt="$(printf '%s' "$v" | jq -r '.optional // false')"
    app="$(printf '%s' "$v" | jq -r '.app // empty')"
    if [ -n "$host" ]; then
        [ "$l" != etc ] || die "etc/$k: a host file is not ours to mirror — use path or fetch"
        if ! t="$(resolve_host "$host")"; then
            [ "$opt" = true ] || die "$l/$k: host '$host' not found"
            say "$l/$k: host '$host' absent — declared, skipped (optional)"; entry "$l" "$k" absent "" "$host" "" "$app"; return 0
        fi
        kind=host; src="$host"
    elif [ -n "$path" ]; then
        src="$(resolve_src "$path")" || exit 1
        if [ ! -e "$src" ]; then
            [ "$opt" = true ] || die "$l/$k: source $src does not exist"
            say "$l/$k: $src absent — declared, skipped (optional)"; entry "$l" "$k" absent "" "$src" "" "$app"; return 0
        fi
        stage_tmp; tmp="$TMPP"
        cp -R -P --preserve=mode,links "$src" "$tmp" || die "$l/$k: could not copy $src"
        unseal "$tmp"
        if [ "$(printf '%s' "$v" | jq -r '.exe // false')" = true ]; then
            # a FUSE source (the phone's CloudDrive) keeps no exec bit: on a
            # directory, exe marks every shebang file executable
            if [ -d "$tmp" ]; then find "$tmp" -type f -exec sh -c 'head -c2 "$1" | grep -q "^#!" && chmod +x "$1"' _ {} \;
            else chmod +x "$tmp"; fi
        fi
        add_store "$tmp" "$k"; t="$OBJ"; kind=path
    else
        sha="$(printf '%s' "$v" | jq -r '.sha256 // empty')"
        [ -n "$sha" ] || die "$l/$k: fetch without sha256 is not reproducible — refused"
        command -v curl >/dev/null 2>&1 || die "$l/$k: fetch needs curl"
        stage_tmp; tmp="$TMPP"
        if ! curl -fsSL -o "$tmp" "$url"; then
            [ "$opt" = true ] || die "$l/$k: download of $url failed"
            rm -f "$tmp"; say "$l/$k: $url unreachable — declared, skipped (optional)"; entry "$l" "$k" absent "" "$url" "" "$app"; return 0
        fi
        if [ "$(sha256sum "$tmp" | cut -d' ' -f1)" != "$sha" ]; then
            # A mismatch is never installed. On an optional entry (a rolling
            # release tag whose pinned hash moved) it is refused loudly and the
            # switch goes on; the page shows it declared · absent.
            rm -f "$tmp"
            [ "$opt" = true ] || die "$l/$k: $url does not match the declared sha256 — refused"
            printf '%s: %s/%s: %s does not match the declared sha256 — REFUSED, not installed (optional: bump the hash from nix/hashes.json)\n' "$ME" "$l" "$k" "$url" >&2
            entry "$l" "$k" absent "" "$url" "" "$app"; return 0
        fi
        [ "$(printf '%s' "$v" | jq -r '.exe // false')" = true ] && chmod +x "$tmp"
        add_store "$tmp" "$k"; t="$OBJ"; kind=fetch; src="$url"
    fi

    sub="$(printf '%s' "$v" | jq -r '.entry // empty')"
    [ -z "$sub" ] || t="$t/$sub"
    [ -e "$t" ] || die "$l/$k: $t does not exist"

    if [ "$l" = bin ]; then
        [ -x "$t" ] || die "bin/$k: $t is not executable"
        if [ "$(printf '%s' "$v" | jq '(.env // {} | length) + (.libs // [] | length)')" != 0 ]; then
            [ "$kind" = host ] && host="$t"
            build_wrapper "$k" "$v" "$t"; t="$OBJ"; kind="$kind+wrap"
        fi
    fi

    genlink "$t" "$l" "$k"
    [ "$kind" = host ] && host="$t"
    entry "$l" "$k" "$kind" "$t" "$src" "$host" "$app"
}

# makeWrapper: env + a PINNED LD_LIBRARY_PATH for exactly this tool. A lib that
# is a directory goes on the path as-is; single .so files are gathered into a
# farm object of links, so the path names store objects and nothing else.
build_wrapper() {
    local k="$1" v="$2" real="$3" w farm ld lt name envs nenv nok
    ld=""
    stage_tmp; farm="$TMPP"; mkdir -p "$farm"
    for name in $(printf '%s' "$v" | jq -r '.libs // [] | .[]'); do
        [ -L "$STAGE/lib/$name" ] || die "bin/$k wants lib '$name', which this profile does not declare"
        lt="$(readlink "$STAGE/lib/$name")"
        if [ -d "$lt" ]; then ld="$ld${ld:+:}$lt"; else ln -s "$lt" "$farm/$name"; fi
    done
    if [ -n "$(ls -A "$farm")" ]; then
        add_store "$farm" "$k-libs"; ld="$OBJ${ld:+:}$ld"
    else
        rm -rf "$farm"
    fi

    nenv="$(printf '%s' "$v" | jq '.env // {} | length')"
    nok="$(printf '%s' "$v" | jq '.env // {} | keys | map(select(test("^[A-Za-z_][A-Za-z0-9_]*$"))) | length')"
    [ "$nenv" = "$nok" ] || die "bin/$k: env names must be shell identifiers"
    envs="$(printf '%s' "$v" | jq -r '.env // {} | to_entries[] | "export \(.key)=\(.value | tostring | @sh)"')"

    stage_tmp; w="$TMPP"
    {
        echo '#!/bin/sh'
        echo "# linux-store wrapper for $k — generated, lives in the store"
        [ -z "$envs" ] || printf '%s\n' "$envs"
        [ -z "$ld" ] || printf 'LD_LIBRARY_PATH=%s${LD_LIBRARY_PATH:+":$LD_LIBRARY_PATH"}; export LD_LIBRARY_PATH\n' "'$ld'"
        printf "exec '%s' \"\$@\"\n" "$real"
    } > "$w"
    chmod 0755 "$w"
    add_store "$w" "$k-wrapper"
}

build_activate() {
    local k="$1" v="$2" f files tmp n
    n="$(printf '%s' "$v" | jq '[has("render"), has("keys"), has("copy")] | map(select(.)) | length')"
    [ "$n" = 1 ] || die "activate/$k: declare exactly one of render, keys, copy"
    stage_tmp; tmp="$TMPP"
    if [ "$(printf '%s' "$v" | jq 'has("copy")')" = true ]; then
        # A real file for a program that cannot follow links (goose), any text
        # format, @HOME@ filled in. Realised and verified exactly like render.
        f="$(resolve_src "$(printf '%s' "$v" | jq -r .copy)")" || exit 1
        [ -f "$f" ] || die "activate/$k: $f does not exist"
        sed "s|@HOME@|$HOME|g" "$f" > "$tmp" || die "activate/$k: could not fill $f"
        add_store "$tmp" "$k"
        genlink "$OBJ" activate "$k"
        entry activate "$k" render "$OBJ" "$f"
    elif [ "$(printf '%s' "$v" | jq 'has("render")')" = true ]; then
        files=""
        for f in $(printf '%s' "$v" | jq -r '.render[]'); do
            f="$(resolve_src "$f")" || exit 1
            [ -f "$f" ] || die "activate/$k: $f does not exist"
            jq empty "$f" 2>/dev/null || die "activate/$k: $f is not valid JSON"
            files="$files $f"
        done
        [ -n "$files" ] || die "activate/$k: render lists no files"
        # Same merge as da_my-ai's cmd_assets and the flakes: deep merge, arrays
        # replaced, @HOME@ substituted (Claude Code stores env values verbatim).
        # shellcheck disable=SC2086
        jq -s --arg home "$HOME" '
            reduce .[] as $x ({}; . * $x)
            | walk(if type == "string" then gsub("@HOME@"; $home) else . end)
        ' $files > "$tmp" || die "activate/$k: merge failed"
        add_store "$tmp" "$k"
        genlink "$OBJ" activate "$k"
        entry activate "$k" render "$OBJ" "$(printf '%s' "$v" | jq -c .render)"
    else
        f="$(resolve_src "$(printf '%s' "$v" | jq -r .keys)")" || exit 1
        [ -f "$f" ] || die "activate/$k: $f does not exist"
        jq -e '.keys | type == "object"' "$f" >/dev/null 2>&1 || die "activate/$k: $f has no .keys object"
        jq '.keys' "$f" > "$tmp"
        add_store "$tmp" "$k-keys"
        genlink "$OBJ" activate "$k"
        entry activate "$k" keys "$OBJ" "$f"
    fi
}

# ── secrets ────────────────────────────────────────────────────────────────
# Two shapes:
#   {"sops": "<src>", "extract": "[\"key\"]", "mode": "600"}   the decrypted value IS the file
#   {"template": "<src>", "values": {"NAME": {"sops": ..., "extract": ...}}}
#                                                    @NAME@ in the template is replaced
# The build only PROVES each value decrypts (to /dev/null), so a missing key or
# a wrong path fails before anything switches. Decryption for real happens in
# realise, into a 0700 scratch dir, and the value is never on argv or stdout.
sops_check() {  # file extract label
    local err="$ROOT/.sopserr.$$" e
    if [ -n "$2" ]; then sops -d --extract "$2" "$1" >/dev/null 2>"$err"
    else sops -d "$1" >/dev/null 2>"$err"; fi
    if [ $? -ne 0 ]; then
        e="$(head -1 "$err")"; rm -f "$err"
        die "$3: cannot decrypt $1${2:+ at $2} — $e (is SOPS_AGE_KEY_FILE set to your age key?)"
    fi
    rm -f "$err"
}

sops_to() {  # file extract out
    if [ -n "$2" ]; then sops -d --extract "$2" "$1" > "$3" 2>/dev/null
    else sops -d "$1" > "$3" 2>/dev/null; fi
}

build_secret() {
    local k="$1" v="$2" mode f x tpl name vals src ph
    [ "$(printf '%s' "$v" | jq 'has("file") and (has("template") | not)')" = true ] \
        || command -v sops >/dev/null 2>&1 || die "secret/$k: needs sops on PATH"
    mode="$(printf '%s' "$v" | jq -r '.mode // "600"')"
    case "$mode" in [0-7][0-7][0-7]) ;; *) die "secret/$k: mode '$mode' is not octal like 600" ;; esac
    if [ "$(printf '%s' "$v" | jq 'has("file")')" = true ]; then
        # A plaintext file that is itself the secret (the vault is a private
        # repo: b0-github/api-key_opaque/token, c2-system/ssh/id_rsa). Checked
        # here, copied at realise, never into store/.
        f="$(resolve_src "$(printf '%s' "$v" | jq -r .file)")" || exit 1
        [ -f "$f" ] && [ -r "$f" ] || die "secret/$k: $f does not exist or is unreadable"
        [ -s "$f" ] || die "secret/$k: $f is empty"
        src="$(jq -nc --arg f "$f" --arg m "$mode" '{kind:"file", file:$f, mode:$m}')"
        entry secret "$k" file "" "$src"
    elif [ "$(printf '%s' "$v" | jq 'has("sops")')" = true ]; then
        f="$(resolve_src "$(printf '%s' "$v" | jq -r .sops)")" || exit 1
        [ -f "$f" ] || die "secret/$k: $f does not exist"
        x="$(printf '%s' "$v" | jq -r '.extract // empty')"
        sops_check "$f" "$x" "secret/$k"
        src="$(jq -nc --arg f "$f" --arg x "$x" --arg m "$mode" '{kind:"sops", file:$f, extract:$x, mode:$m}')"
        entry secret "$k" sops "" "$src"
    elif [ "$(printf '%s' "$v" | jq 'has("template")')" = true ]; then
        tpl="$(resolve_src "$(printf '%s' "$v" | jq -r .template)")" || exit 1
        [ -f "$tpl" ] || die "secret/$k: template $tpl does not exist"
        stage_tmp; cp "$tpl" "$TMPP"; add_store "$TMPP" "$(basename "$k").tpl"
        vals='{}'
        for name in $(printf '%s' "$v" | jq -r '.values // {} | keys[]'); do
            printf '%s' "$name" | grep -qE '^[A-Z][A-Z0-9_]*$' || die "secret/$k: value name '$name' must be UPPER_SNAKE"
            # The marker in the template: @NAME@ unless the value names its
            # own (the vault's WireGuard profiles carry <PROVIDED_BY_DEVICE>,
            # the same marker the phone splices its stored key into).
            ph="$(printf '%s' "$v" | jq -r --arg n "$name" '.values[$n].placeholder // ("@" + $n + "@")')"
            grep -qF "$ph" "$tpl" || die "secret/$k: template has no $ph"
            if [ "$(printf '%s' "$v" | jq --arg n "$name" '.values[$n] | has("file")')" = true ]; then
                f="$(resolve_src "$(printf '%s' "$v" | jq -r --arg n "$name" '.values[$n].file')")" || exit 1
                [ -s "$f" ] || die "secret/$k: $name: $f does not exist or is empty"
                vals="$(printf '%s' "$vals" | jq -c --arg n "$name" --arg f "$f" --arg ph "$ph" '. + {($n): {file:$f, plain:true, placeholder:$ph}}')"
                continue
            fi
            f="$(resolve_src "$(printf '%s' "$v" | jq -r --arg n "$name" '.values[$n].sops // empty')")" || exit 1
            [ -f "$f" ] || die "secret/$k: $name: $f does not exist"
            x="$(printf '%s' "$v" | jq -r --arg n "$name" '.values[$n].extract // empty')"
            sops_check "$f" "$x" "secret/$k: $name"
            vals="$(printf '%s' "$vals" | jq -c --arg n "$name" --arg f "$f" --arg x "$x" --arg ph "$ph" '. + {($n): {file:$f, extract:$x, placeholder:$ph}}')"
        done
        [ "$vals" != '{}' ] || die "secret/$k: template declares no values"
        src="$(jq -nc --arg t "$OBJ" --argjson v "$vals" --arg m "$mode" '{kind:"template", template:$t, values:$v, mode:$m}')"
        entry secret "$k" template "$OBJ" "$src"
    else
        die "secret/$k: declare file, sops or template"
    fi
}

# render_secret <source json> <out>   (caller holds umask 077)
render_secret() {
    local src="$1" out="$2" d i=0 name f x args filter
    case "$(printf '%s' "$src" | jq -r .kind)" in
        file)
            cp "$(printf '%s' "$src" | jq -r .file)" "$out" || return 1
            [ -z "$(tail -c1 "$out")" ] || echo >> "$out"
            ;;
        sops)
            sops_to "$(printf '%s' "$src" | jq -r .file)" "$(printf '%s' "$src" | jq -r .extract)" "$out" \
                || return 1
            # key files must end in a newline or ssh refuses them
            [ -z "$(tail -c1 "$out")" ] || echo >> "$out"
            ;;
        template)
            d="$ROOT/.render.$$"; rm -rf "$d"; mkdir -m 700 "$d" || return 1
            args=""; filter='$t'
            for name in $(printf '%s' "$src" | jq -r '.values | keys[]'); do
                i=$((i + 1))
                f="$(printf '%s' "$src" | jq -r --arg n "$name" '.values[$n].file')"
                if [ "$(printf '%s' "$src" | jq -r --arg n "$name" '.values[$n].plain // false')" = true ]; then
                    cp "$f" "$d/v$i" || { rm -rf "$d"; return 1; }
                else
                    x="$(printf '%s' "$src" | jq -r --arg n "$name" '.values[$n].extract')"
                    sops_to "$f" "$x" "$d/v$i" || { rm -rf "$d"; return 1; }
                fi
                printf '%s' "$(printf '%s' "$src" | jq -r --arg n "$name" '.values[$n].placeholder // ("@" + $n + "@")')" > "$d/p$i"
                args="$args --rawfile v$i $d/v$i --rawfile p$i $d/p$i"
                # split/join: a literal replacement, no regex to escape
                filter="$filter | split(\$p$i) | join(\$v$i | sub(\"\\n\$\"; \"\"))"
            done
            # shellcheck disable=SC2086
            jq -nj --rawfile t "$(printf '%s' "$src" | jq -r .template)" $args "$filter" > "$out" \
                || { rm -rf "$d"; return 1; }
            rm -rf "$d"
            ;;
        *) return 1 ;;
    esac
}

secret_lines() { jq -r '.entries[] | select(.layer == "secret") | [.name, .source] | join("\u001f")' "$1/manifest.json"; }

state_set() {  # name sha
    touch "$ROOT/secrets.state"; chmod 600 "$ROOT/secrets.state"
    grep -v "^$1 " "$ROOT/secrets.state" > "$ROOT/secrets.state.$$" 2>/dev/null
    echo "$1 $2" >> "$ROOT/secrets.state.$$"
    mv -T "$ROOT/secrets.state.$$" "$ROOT/secrets.state"
}
state_get() { [ -f "$ROOT/secrets.state" ] && awk -v n="$1" '$1 == n { print $2 }' "$ROOT/secrets.state"; }

realise_secrets() {  # new prev
    local new="$1" prev="$2" old name src dst out mode sha
    old="$(umask)"; umask 077
    secret_lines "$new" > "$ROOT/.secrets.$$"
    while IFS="$(printf '\037')" read -r name src; do
        dst="$HOME/$name"
        mkdir -p "$(dirname "$dst")"
        case "$name" in .ssh/*) chmod 700 "$HOME/.ssh" ;; esac
        out="$dst.linux-store.$$"
        render_secret "$src" "$out" || { rm -f "$out" "$ROOT/.secrets.$$"; umask "$old"; die "secret/$name: decryption failed during realise"; }
        mode="$(printf '%s' "$src" | jq -r .mode)"
        chmod "$mode" "$out"
        sha="$(sha256sum "$out" | cut -d' ' -f1)"
        if cmp -s "$out" "$dst" 2>/dev/null && [ "$(stat -c %a "$dst")" = "$mode" ]; then
            rm -f "$out"
        else
            mv -T "$out" "$dst" || { rm -f "$out"; die "could not write $dst"; }
            say "secret $dst written (mode $mode)"
        fi
        state_set "$name" "$sha"
    done < "$ROOT/.secrets.$$"
    rm -f "$ROOT/.secrets.$$"
    if [ -n "$prev" ] && [ -f "$prev/manifest.json" ]; then
        for name in $(jq -r '.entries[] | select(.layer == "secret") | .name' "$prev/manifest.json"); do
            jq -e --arg n "$name" 'any(.entries[]; .layer == "secret" and .name == $n)' "$new/manifest.json" >/dev/null \
                || say "warning — secret $HOME/$name is no longer declared; left in place (delete it yourself if intended)"
        done
    fi
    umask "$old"
}

next_gen() {
    _max=0
    for _g in "$GENS/$1"-*; do
        [ -d "$_g" ] || continue
        _b="${_g##*/$1-}"
        case "$_b" in ''|*[!0-9]*) continue ;; esac
        [ "$_b" -le "$_max" ] || _max="$_b"
    done
    echo $((_max + 1))
}

build() {  # profile  →  sets GEN
    local p="$1" n line objs
    need_decl
    GB="$(git_base)" || exit 1
    mkdir -p "$STORE" "$GENS"
    n="$(next_gen "$p")"
    STAGE="$GENS/.build.$$"; OBJTMP="$STORE/.stage.$$"; _n=0
    rm -rf "$STAGE" "$OBJTMP"
    mkdir -p "$STAGE/bin" "$STAGE/lib" "$STAGE/etc" "$STAGE/activate" "$OBJTMP"
    : > "$STAGE/.objects"; : > "$STAGE/.entries"

    # The engine is a store object like any other: `linux-store` on PATH is the
    # exact copy that built this generation.
    stage_tmp; cp "$SELF" "$TMPP"; chmod 0755 "$TMPP"
    add_store "$TMPP" linux-store
    genlink "$OBJ" bin linux-store
    entry bin linux-store self "$OBJ" "$SELF"

    plan "$p" > "$STAGE/.plan" || die "could not plan $DECL for $p"
    while IFS= read -r line; do
        build_entry "$line"
    done < "$STAGE/.plan"
    fault populate

    objs="$(sort -u "$STAGE/.objects" | jq -R . | jq -sc .)"
    jq -s --arg p "$p" --arg g "$p-$n" --arg gb "$GB" --arg decl "$DECL" \
          --arg dsha "$(merged_decl | sha256sum | cut -d' ' -f1)" --arg at "$(date -u +%FT%TZ)" \
          --argjson objs "$objs" \
        '{profile:$p, generation:$g, created:$at, git_base:$gb, declaration:$decl,
          declaration_sha256:$dsha, entries:., objects:$objs}' \
        "$STAGE/.entries" > "$STAGE/manifest.json" || die "could not write the manifest"
    rm -f "$STAGE/.plan" "$STAGE/.objects" "$STAGE/.entries"
    rm -rf "$OBJTMP"

    # Visible under its name only once complete.
    mv -T "$STAGE" "$GENS/$p-$n" || die "could not seal generation $p-$n"
    fault seal
    GEN="$GENS/$p-$n"
}

# ── switch + realise $HOME ─────────────────────────────────────────────────
switch_to() {
    local tmp="$ROOT/.current.$$"
    [ -f "$1/manifest.json" ] || die "$1 is not a generation"
    rm -f "$tmp"
    ln -s "$1" "$tmp" || die "could not stage the current link"
    fault switch
    mv -T "$tmp" "$CUR" || { rm -f "$tmp"; die "could not switch to $1"; }
}

in_dev() { [ -f "$DEVLIST" ] && grep -Fxq "$1" "$DEVLIST"; }

etc_names()      { [ -f "$1/manifest.json" ] && jq -r '.entries[] | select(.layer == "etc") | .name' "$1/manifest.json"; }
activate_lines() { jq -r '.entries[] | select(.layer == "activate") | [.name, .kind, .target] | join("\u001f")' "$1/manifest.json"; }

# A $HOME path we may take over: absent, already ours, or (with --backup) moved
# aside. Anything nix owns is refused outright — one manager per file.
claim() {  # rel  backup(0|1)  what(etc|activate)
    local dst="$HOME/$1" t r par b
    par="$(dirname "$dst")"
    if [ -e "$par" ]; then
        case "$(readlink -f "$par")" in
            /nix/store/*) die "$par resolves into /nix/store — that tree belongs to nix/home-manager" ;;
        esac
    fi
    if [ -L "$dst" ]; then
        t="$(readlink "$dst")"; r="$(readlink -f "$dst" 2>/dev/null || true)"
        if [ "$3" = etc ]; then
            [ "$t" = "$CUR/etc/$1" ] && return 0
            in_dev "$1" && return 0
        else
            [ "$t" = "$CUR/etc/$1" ] && return 0   # was etc, now activate: realise unlinks it
        fi
        case "$t $r" in
            */nix/store/*) die "$dst links into nix ($t) — that file belongs to nix/home-manager; remove it from one of the two" ;;
        esac
    elif [ ! -e "$dst" ]; then
        return 0
    elif [ "$3" = activate ] && [ -f "$dst" ]; then
        return 0   # activate writes real files; an existing one is what it updates
    fi
    [ "$2" = 1 ] || die "$dst exists and is not managed by linux-store — move it away, or re-run with --backup"
    b="$dst.linux-store-backup.$(date +%Y%m%d%H%M%S)"
    mv "$dst" "$b" || die "could not back up $dst"
    say "backed up $dst -> $b"
}

preflight() {  # gen backup
    local rel name kind t
    for rel in $(etc_names "$1"); do claim "$rel" "$2" etc; done
    # a file, not a pipe: claim() dies, and a die inside a pipeline's subshell
    # would not stop the switch
    activate_lines "$1" > "$ROOT/.preflight.$$"
    while IFS="$(printf '\037')" read -r name kind t; do
        claim "$name" "$2" activate
    done < "$ROOT/.preflight.$$"
    secret_lines "$1" > "$ROOT/.preflight.$$"
    while IFS="$(printf '\037')" read -r name t; do
        claim "$name" "$2" activate
    done < "$ROOT/.preflight.$$"
    rm -f "$ROOT/.preflight.$$"
}

link_home() {  # rel target
    local dst="$HOME/$1" tmp
    [ "$(readlink "$dst" 2>/dev/null || true)" = "$2" ] && return 0
    mkdir -p "$(dirname "$dst")"
    tmp="$dst.linux-store.$$"
    rm -f "$tmp"
    ln -s "$2" "$tmp" && mv -T "$tmp" "$dst" || { rm -f "$tmp"; die "could not link $dst"; }
}

write_atomic() {  # src dst
    local tmp="$2.linux-store.$$"
    mkdir -p "$(dirname "$2")"
    cp "$1" "$tmp" && chmod u+w "$tmp" && mv -T "$tmp" "$2" || { rm -f "$tmp"; die "could not write $2"; }
}

realise() {  # new-gen  prev-gen(may be empty)
    local new="$1" prev="$2" rel name kind t dst
    # 1. links the previous generation owned that this one does not
    if [ -n "$prev" ] && [ -f "$prev/manifest.json" ]; then
        for rel in $(etc_names "$prev"); do
            etc_names "$new" | grep -Fxq "$rel" && continue
            dst="$HOME/$rel"
            if [ "$(readlink "$dst" 2>/dev/null || true)" = "$CUR/etc/$rel" ]; then
                rm -f "$dst"; say "unlinked $dst (no longer declared)"
            elif in_dev "$rel"; then
                say "warning — $rel is no longer declared but is still in dev mode; left as is"
            fi
        done
    fi
    # 2. every declared etc path points through `current`
    for rel in $(etc_names "$new"); do
        in_dev "$rel" && continue
        link_home "$rel" "$CUR/etc/$rel"
    done
    # 3. activate: render whole, or patch keys
    fault activate
    activate_lines "$new" > "$ROOT/.activate.$$"
    while IFS="$(printf '\037')" read -r name kind t; do
        dst="$HOME/$name"
        [ -L "$dst" ] && [ "$(readlink "$dst")" = "$CUR/etc/$name" ] && rm -f "$dst"
        case "$kind" in
            render)
                cmp -s "$t" "$dst" 2>/dev/null || { write_atomic "$t" "$dst"; say "rendered $dst"; }
                ;;
            keys)
                if [ ! -f "$dst" ]; then
                    say "$dst does not exist yet — nothing to patch before its first run"
                    continue
                fi
                if ! jq -e --slurpfile f "$t" '. as $e | $f[0] | to_entries | all(. as $kv | $e[$kv.key] == $kv.value)' "$dst" >/dev/null 2>&1; then
                    jq --slurpfile f "$t" '. + $f[0]' "$dst" > "$dst.linux-store.$$" && [ -s "$dst.linux-store.$$" ] \
                        && mv -T "$dst.linux-store.$$" "$dst" \
                        || { rm -f "$dst.linux-store.$$"; die "could not patch $dst"; }
                    say "patched $dst ($(jq -r 'keys | join(", ")' "$t"))"
                fi
                ;;
        esac
    done < "$ROOT/.activate.$$"
    rm -f "$ROOT/.activate.$$"
    # 4. secrets, decrypted here and nowhere else
    realise_secrets "$new" "$prev"
}

write_env() {
    cat > "$ROOT/env.sh" <<EOF
# generated by linux-store — source from your shell rc
case ":\$PATH:" in *":$CUR/bin:"*) ;; *) PATH="$CUR/bin:\$PATH"; export PATH ;; esac
EOF
    cat > "$ROOT/env.fish" <<EOF
# generated by linux-store — source from config.fish
contains -- $CUR/bin \$PATH; or set -gx PATH $CUR/bin \$PATH
EOF
}

prune() {
    local p="$1" keep="${LINUX_STORE_KEEP:-5}" live drop g
    live="$(readlink "$CUR" 2>/dev/null || true)"
    # basenames, not paths: a path may itself contain '-'
    drop=$(( $(cd "$GENS" && ls -1d "$p"-* 2>/dev/null | wc -l) - keep ))
    [ "$drop" -gt 0 ] || return 0
    for g in $(cd "$GENS" && ls -1d "$p"-* | sort -t- -k2,2n); do
        [ "$drop" -gt 0 ] || break
        [ "$GENS/$g" = "$live" ] && continue
        rm -rf "${GENS:?}/$g"; drop=$((drop - 1))
    done
}

lock() {
    mkdir -p "$ROOT"
    chmod 700 "$ROOT"
    exec 9>>"$ROOT/lock"
    flock -n 9 || die "another linux-store holds $ROOT/lock"
}

gen_path() {  # "termux-3" | "3" | path
    case "$1" in
        /*) echo "$1" ;;
        *-*) echo "$GENS/$1" ;;
        *) _gp="$(detect_profile)" || exit 1; echo "$GENS/$_gp-$1" ;;
    esac
}

same_profile() {
    local gp mp
    gp="$(jq -r .profile "$1/manifest.json")"; mp="$(detect_profile)" || exit 1 || exit 1
    [ "$gp" = "$mp" ] || die "${1##*/} is a $gp generation and this machine is $mp — refused (LINUX_STORE_PROFILE overrides detection)"
}

# ── verify ─────────────────────────────────────────────────────────────────
check() {
    local gen mp gp o l k kind t s h want got
    BAD=0
    if [ ! -L "$CUR" ]; then fail "$CUR is missing — nothing is live; run switch"; return 1; fi
    gen="$(readlink "$CUR")"
    if [ ! -f "$gen/manifest.json" ]; then fail "$CUR points at $gen, which is not a generation"; return 1; fi
    mp="$(detect_profile)" || exit 1; gp="$(jq -r .profile "$gen/manifest.json")"
    [ "$gp" = "$mp" ] || fail "live generation is $gp, this machine is $mp"

    for o in $(jq -r '.objects[]' "$gen/manifest.json"); do
        if [ ! -e "$o" ]; then fail "store object $o is gone"; continue; fi
        want="$(basename "$o" | cut -c1-32)"; got="$(hash_path "$o" | cut -c1-32)"
        [ "$want" = "$got" ] || fail "store object $o does not match its hash (edited in place?) — repair replaces it"
    done

    jq -r '.entries[] | [.layer, .name, .kind, .target, .source, .host] | join("\u001f")' "$gen/manifest.json" > "$ROOT/.verify.$$"
    while IFS="$(printf '\037')" read -r l k kind t s h; do
        [ "$kind" != absent ] || continue   # declared, not present on this box: never a failure
        [ -z "$h" ] || [ -e "$h" ] || fail "$l/$k: host binary $h is gone (apt/nix upgraded it?) — repair re-resolves it"
        if [ "$l" = secret ]; then
            want="$(printf '%s' "$s" | jq -r .mode)"
            if [ -L "$HOME/$k" ] || [ ! -f "$HOME/$k" ]; then
                fail "secret $HOME/$k is missing (or a link) — repair re-decrypts it"
            elif [ "$(stat -c %a "$HOME/$k")" != "$want" ]; then
                fail "secret $HOME/$k has mode $(stat -c %a "$HOME/$k"), declared $want"
            elif [ "$(sha256sum "$HOME/$k" | cut -d' ' -f1)" != "$(state_get "$k")" ]; then
                fail "secret $HOME/$k differs from what was decrypted at apply (edited?) — repair rewrites it"
            fi
            continue
        fi
        if [ "$l" = activate ]; then
            case "$kind" in
                render) cmp -s "$t" "$HOME/$k" || fail "$HOME/$k differs from the rendered declaration (edited since apply?) — repair rewrites it" ;;
                keys)
                    if [ -f "$HOME/$k" ] && ! jq -e --slurpfile f "$t" '. as $e | $f[0] | to_entries | all(. as $kv | $e[$kv.key] == $kv.value)' "$HOME/$k" >/dev/null 2>&1; then
                        fail "$HOME/$k: declared keys $(jq -r 'keys | join(", ")' "$t") are not all set"
                    fi ;;
            esac
            continue
        fi
        [ "$(readlink "$gen/$l/$k" 2>/dev/null || true)" = "$t" ] || fail "$l/$k: generation link does not point at $t"
        [ -e "$gen/$l/$k" ] || fail "$l/$k: $t is dangling"
        if [ "$l" = etc ]; then
            if in_dev "$k"; then
                [ "$(readlink "$HOME/$k" 2>/dev/null || true)" = "$s" ] \
                    || fail "$HOME/$k is in dev mode but does not point at $s"
            else
                [ "$(readlink "$HOME/$k" 2>/dev/null || true)" = "$CUR/etc/$k" ] \
                    || fail "$HOME/$k is not linked to $CUR/etc/$k"
            fi
        fi
    done < "$ROOT/.verify.$$"
    rm -f "$ROOT/.verify.$$"

    if [ "$BAD" -eq 0 ]; then
        say "ok — ${gen##*/}, every declared link, object and file checks out"
        [ ! -s "$DEVLIST" ] || say "dev mode (out-of-store) for: $(paste -sd' ' "$DEVLIST")"
    fi
    return "$BAD"
}

# ── commands ───────────────────────────────────────────────────────────────
cmd_build() {
    local p
    p="$(detect_profile)" || exit 1
    if [ "${1:-}" = --profile ]; then p="${2:-}"; LINUX_STORE_PROFILE="$p" detect_profile >/dev/null; fi
    lock
    build "$p"
    say "built ${GEN##*/} (not switched)"
    echo "$GEN"
}

cmd_switch() {
    local backup=0 p prev
    [ "${1:-}" = --backup ] && backup=1
    p="$(detect_profile)" || exit 1
    lock
    prev="$(readlink "$CUR" 2>/dev/null || true)"
    build "$p"
    preflight "$GEN" "$backup"
    switch_to "$GEN"
    realise "$GEN" "$prev"
    write_env
    printf '%s\n' "$DECL" > "$ROOT/declaration"
    prune "$p"
    say "${GEN##*/} is live"
    check
}

cmd_switch_generation() {  # target-gen
    local g prev
    g="$(gen_path "$1")"
    [ -f "$g/manifest.json" ] || die "no generation ${1}"
    same_profile "$g"
    lock
    prev="$(readlink "$CUR" 2>/dev/null || true)"
    preflight "$g" 0
    switch_to "$g"
    realise "$g" "$prev"
    say "switched to ${g##*/}"
    check
}

cmd_rollback() {
    local live p cur g b best=""
    live="$(readlink "$CUR" 2>/dev/null || true)"
    [ -n "$live" ] || die "nothing is live, so there is nothing to roll back from"
    p="$(jq -r .profile "$live/manifest.json")"; cur="${live##*/$p-}"
    for g in "$GENS/$p"-*; do
        b="${g##*/$p-}"
        case "$b" in ''|*[!0-9]*) continue ;; esac
        [ "$b" -lt "$cur" ] || continue
        [ -z "$best" ] || [ "$b" -gt "$best" ] || continue
        best="$b"
    done
    [ -n "$best" ] || die "$p-$cur is the oldest generation kept; nothing to roll back to"
    cmd_switch_generation "$p-$best"
}

cmd_list_generations() {
    local live g
    live="$(readlink "$CUR" 2>/dev/null || true)"
    for g in $(cd "$GENS" 2>/dev/null && ls -1d *-* 2>/dev/null | sort -t- -k1,1 -k2,2n); do
        g="$GENS/$g"
        [ -f "$g/manifest.json" ] || continue
        if [ "$g" = "$live" ]; then echo "${g##*/}  (live)  $(jq -r .created "$g/manifest.json")"
        else echo "${g##*/}  $(jq -r .created "$g/manifest.json")"; fi
    done
}

cmd_diff() {
    local a b live
    live="$(readlink "$CUR" 2>/dev/null || true)"
    if [ $# -ge 2 ]; then a="$(gen_path "$1")"; b="$(gen_path "$2")"
    elif [ $# -eq 1 ]; then a="$(gen_path "$1")"; b="$live"
    else die "usage: diff <gen> [<gen>]"; fi
    [ -f "$a/manifest.json" ] && [ -f "$b/manifest.json" ] || die "both generations must exist"
    _q='.entries[] | "\(.layer)/\(.name)\t\(.kind)\t\(.target | sub("^.*/store/"; "store/"))"'
    jq -r "$_q" "$a/manifest.json" | LC_ALL=C sort > "$ROOT/.diff.a.$$"
    jq -r "$_q" "$b/manifest.json" | LC_ALL=C sort > "$ROOT/.diff.b.$$"
    diff -u --label "${a##*/}" --label "${b##*/}" "$ROOT/.diff.a.$$" "$ROOT/.diff.b.$$"
    rm -f "$ROOT/.diff.a.$$" "$ROOT/.diff.b.$$"
    return 0
}

cmd_gc() {
    local live o n=0
    lock
    [ -d "$STORE" ] || { say "empty store"; return 0; }
    cat "$GENS"/*/manifest.json 2>/dev/null | jq -r '.objects[]' | sort -u > "$ROOT/.roots.$$"
    for o in "$STORE"/* "$STORE"/.stage.*; do
        [ -e "$o" ] || continue
        grep -Fxq "$o" "$ROOT/.roots.$$" && continue
        unseal "$o"; rm -rf "$o"; n=$((n + 1))
    done
    rm -rf "$GENS"/.build.* 2>/dev/null
    rm -f "$ROOT/.roots.$$"
    say "gc: removed $n unreferenced store object(s)"
}

cmd_dev() {  # [--off] rel   |   (no args: list)
    local off=0 rel live s
    if [ $# -eq 0 ]; then [ -f "$DEVLIST" ] && cat "$DEVLIST"; return 0; fi
    [ "$1" = --off ] && { off=1; shift; }
    rel="${1:?usage: dev [--off] <etc path>}"
    live="$(readlink "$CUR" 2>/dev/null || true)"
    [ -n "$live" ] || die "nothing is live; apply first"
    s="$(jq -r --arg k "$rel" '.entries[] | select(.layer == "etc" and .name == $k) | select(.kind == "path") | .source' "$live/manifest.json")"
    [ -n "$s" ] || die "$rel is not a path-sourced etc entry of ${live##*/}"
    lock
    if [ "$off" = 1 ]; then
        [ -f "$DEVLIST" ] && grep -Fxv "$rel" "$DEVLIST" > "$DEVLIST.tmp"; mv -f "$DEVLIST.tmp" "$DEVLIST" 2>/dev/null || true
        link_home "$rel" "$CUR/etc/$rel"
        say "$rel back in the store"
    else
        in_dev "$rel" || echo "$rel" >> "$DEVLIST"
        link_home "$rel" "$s"
        say "$rel -> $s (out of store; edits are live, 'dev --off' to freeze)"
    fi
}

cmd_status() {
    local live
    live="$(readlink "$CUR" 2>/dev/null || true)"
    printf 'Profile:      %s\n' "$(detect_profile 2>/dev/null || echo '?')"
    printf 'System:       %s (%s)  user %s  home %s\n' "$(uname -s)" "$(uname -m)" "$(id -un)" "$HOME"
    printf 'Store root:   %s\n' "$ROOT"
    printf 'Declaration:  %s\n' "${DECL:-<none>}"
    if [ -n "$live" ] && [ -f "$live/manifest.json" ]; then
        printf 'Live:         %s  (built %s)\n' "${live##*/}" "$(jq -r .created "$live/manifest.json")"
        printf 'Entries:      %s   (declared · absent: %s)\n' "$(jq -r '.entries | map(select(.kind != "absent")) | group_by(.layer) | map("\(.[0].layer)=\(length)") | join(" ")' "$live/manifest.json")" "$(jq -r '[.entries[] | select(.kind == "absent")] | length' "$live/manifest.json")"
    else
        printf 'Live:         none — run switch\n'
    fi
    printf 'Generations:  %s\n' "$(cd "$GENS" 2>/dev/null && ls -1d *-* 2>/dev/null | wc -l | tr -d ' ')"
    printf 'Store:        %s objects, %s\n' "$(ls -1 "$STORE" 2>/dev/null | wc -l | tr -d ' ')" "$(du -sh "$STORE" 2>/dev/null | cut -f1)"
    [ ! -s "$DEVLIST" ] || printf 'Dev mode:     %s\n' "$(paste -sd' ' "$DEVLIST")"
}

# What the declaration resolves to for this profile — the flake's `show`.
cmd_show() {
    local p
    need_decl
    p="$(detect_profile)" || exit 1
    printf '%s  (profile %s)\n' "$DECL" "$p"
    plan "$p" | jq -r '"  \(.l)/\(.k)  \(.v | del(.[] | select(. == null)) | tojson)"'
}

# The flake's `update`: refresh the checkouts the declaration reads from,
# then switch. Each root is pulled fast-forward only; a root that cannot be
# pulled (no auth, no remote) is reported and the switch still runs on what is
# there, like the flake deploying committed copies when a SoT is absent.
cmd_update() {
    local noswitch=0 r d gb
    [ "${1:-}" = --no-switch ] && noswitch=1
    need_decl
    gb="$(git_base)" || exit 1
    for r in "$gb/cloud-me_configs" $(jq -r '.settings.roots // {} | .[]' "$DECL" | sed "s|^|$gb/|" | cut -d/ -f1-"$(printf '%s' "$gb" | tr -cd / | wc -c | awk '{print $1+2}')" | sort -u); do
        d="$(cd "$r" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)" || continue
        if git -C "$d" pull -q --ff-only 2>/dev/null; then say "updated ${d##*/}"
        else say "warning — ${d##*/}: pull failed (no auth or not fast-forward); using the checkout as is"; fi
    done
    [ "$noswitch" = 1 ] || cmd_switch
}

# ── tui: the Store tab, in the terminal ─────────────────────────────────────
# Same split as cloud-superapp's Store (Phone | Cloud) and the flake build.sh's
# numbered tui: PHONE is this device's live store, CLOUD is the declaration in
# cloud-me_configs. Plain sh + printf; every item calls the same cmd_* the CLI
# verbs call, so the tui can never do something the CLI cannot.
C_B="$(printf '\033[1m')"; C_C="$(printf '\033[36m')"; C_G="$(printf '\033[32m')"
C_Y="$(printf '\033[33m')"; C_R="$(printf '\033[31m')"; C_D="$(printf '\033[2m')"; C_N="$(printf '\033[0m')"
pause() { printf '\n%sEnter to continue%s ' "$C_D" "$C_N"; read -r _ || true; }
ask()   { printf '%s%s%s ' "$C_B" "$1" "$C_N"; read -r REPLY || REPLY=q; }

tui_header() {
    local live p
    clear 2>/dev/null || printf '\033[H\033[2J'
    live="$(readlink "$CUR" 2>/dev/null || true)"; p="$(detect_profile 2>/dev/null || echo '?')"
    printf '%s┌─ linux-store ─ %s ──────────────────────────────────────┐%s\n' "$C_C" "$p" "$C_N"
    if [ -n "$live" ] && [ -f "$live/manifest.json" ]; then
        printf '%s│%s  live %s%s%s   %s   %s%s\n' "$C_C" "$C_N" "$C_G" "${live##*/}" "$C_N" \
            "$(jq -r '.entries | group_by(.layer) | map("\(.[0].layer) \(length)") | join(" · ")' "$live/manifest.json")" "$C_D" "$C_N"
    else
        printf '%s│%s  %snothing live — Switch to build the first generation%s\n' "$C_C" "$C_N" "$C_Y" "$C_N"
    fi
    printf '%s│%s  %s%s%s\n' "$C_C" "$C_N" "$C_D" "${DECL:-<no declaration>}" "$C_N"
    printf '%s└──────────────────────────────────────────────────────────────┘%s\n\n' "$C_C" "$C_N"
}

tui_entries() {  # layer
    local live
    live="$(readlink "$CUR" 2>/dev/null || true)"
    [ -f "$live/manifest.json" ] || { echo "nothing live"; return; }
    jq -r --arg l "$1" '.entries[] | select(.layer == $l)
        | "  \(.name)\t\(.kind)\t\(if .layer == "secret" then (.source | fromjson | .file | sub("^.*/"; "")) else (.target | sub("^.*/store/"; "store/")) end)"' \
        "$live/manifest.json" | column -t -s "$(printf '\t')" 2>/dev/null || cat
}

tui_phone() {
    while :; do
        tui_header
        printf '%s PHONE — this device%s\n\n' "$C_B" "$C_N"
        printf '  %s1)%s Status          %s2)%s Check          %s3)%s Repair\n' "$C_G" "$C_N" "$C_G" "$C_N" "$C_G" "$C_N"
        printf '  %s4)%s Generations     %s5)%s Rollback       %s6)%s Switch to generation\n' "$C_G" "$C_N" "$C_G" "$C_N" "$C_G" "$C_N"
        printf '  %s7)%s bin  %s8)%s lib  %s9)%s etc  %s0)%s activate  %ss)%s secrets   %sd)%s dev mode\n' "$C_G" "$C_N" "$C_G" "$C_N" "$C_G" "$C_N" "$C_G" "$C_N" "$C_G" "$C_N" "$C_G" "$C_N"
        printf '  %sg)%s gc              %sb)%s back\n\n' "$C_G" "$C_N" "$C_Y" "$C_N"
        ask "Choice:"
        case "$REPLY" in
            1) cmd_status; pause ;;
            2) check || true; pause ;;
            3) if check; then say "nothing to repair"; else cmd_switch; fi; pause ;;
            4) cmd_list_generations; pause ;;
            5) cmd_rollback || true; pause ;;
            6) cmd_list_generations; ask "Generation (e.g. 3):"; [ -n "$REPLY" ] && { cmd_switch_generation "$REPLY" || true; }; pause ;;
            7) tui_entries bin; pause ;;   8) tui_entries lib; pause ;;
            9) tui_entries etc; pause ;;   0) tui_entries activate; pause ;;
            s) tui_entries secret; pause ;;
            d) cmd_dev; ask "etc path to toggle (empty = none):"; [ -n "$REPLY" ] && { if in_dev "$REPLY"; then cmd_dev --off "$REPLY"; else cmd_dev "$REPLY"; fi || true; }; pause ;;
            g) cmd_gc || true; pause ;;
            b|q) return ;;
        esac
    done
}

tui_cloud() {
    while :; do
        tui_header
        printf '%s CLOUD — the declaration (cloud-me_configs)%s\n\n' "$C_B" "$C_N"
        printf '  %s1)%s Switch   build from the declaration and make it live\n' "$C_G" "$C_N"
        printf '  %s2)%s Update   pull the checkouts, then switch\n' "$C_G" "$C_N"
        printf '  %s3)%s Build    build only (no switch)\n' "$C_G" "$C_N"
        printf '  %s4)%s Show     what the declaration resolves to\n' "$C_G" "$C_N"
        printf '  %s5)%s Diff     live generation vs the previous one\n' "$C_G" "$C_N"
        printf '  %s6)%s Edit     open the declaration in $EDITOR\n' "$C_G" "$C_N"
        printf '  %sb)%s back\n\n' "$C_Y" "$C_N"
        ask "Choice:"
        case "$REPLY" in
            1) cmd_switch || true; pause ;;
            2) cmd_update || true; pause ;;
            3) cmd_build || true; pause ;;
            4) cmd_show 2>&1 | ${PAGER:-less} ;;
            5) _l="$(readlink "$CUR" 2>/dev/null || true)"; _n="${_l##*-}"; [ -n "$_n" ] && [ "$_n" -gt 1 ] 2>/dev/null && cmd_diff "$((_n - 1))" || echo "no previous generation"; pause ;;
            6) [ -n "$DECL" ] && ${EDITOR:-vi} "$DECL" ;;
            b|q) return ;;
        esac
    done
}

cmd_tui() {
    [ -t 0 ] || [ -n "${LINUX_STORE_TUI_TEST:-}" ] || die "tui needs a terminal"
    while :; do
        tui_header
        printf '  %s1)%s PHONE   this device: status, check, generations, what is installed\n' "$C_G" "$C_N"
        printf '  %s2)%s CLOUD   the declaration: switch, update, show, edit\n' "$C_G" "$C_N"
        printf '  %sq)%s quit\n\n' "$C_R" "$C_N"
        ask "Choice:"
        case "$REPLY" in
            1) tui_phone ;;
            2) tui_cloud ;;
            q|Q) return 0 ;;
        esac
    done
}

# ── html: the Store as a page, served by my-webserver ──────────────────────
# Two tiers, drawn apart on purpose: OS · Terraforms (the machine: what
# cloud-me_configs/B_CONFIGS-MACHINES/<machine> owns — NixOS flakes, OS
# configs, terraform) versus Home-Manager · Desktop (the user: what this store
# realises — binaries, scripts/libs, configs, secrets), grouped by app.
UI="${LINUX_STORE_UI:-$ROOT/ui}"
machine_of() { case "$1" in termux) echo samsung-s21plus ;; desktop) echo surface-8pro ;; *) echo "" ;; esac; }
hesc() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }

html_css() {
    cat <<'EOF'
:root{--bg:#0f1117;--fg:#d6d9e0;--dim:#8b90a0;--card:#171a23;--line:#262a36;--on:#3fb950;--off:#f85149;--unk:#d29922;--acc:#58a6ff;--os:#bc8cff;--hm:#39d2c0}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.45 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
header{padding:18px 24px;border-bottom:1px solid var(--line);display:flex;gap:24px;align-items:baseline;flex-wrap:wrap}
header h1{margin:0;font-size:18px}header nav a{color:var(--acc);margin-right:14px;text-decoration:none}header .meta{color:var(--dim)}
main{padding:20px 24px;display:grid;gap:22px;grid-template-columns:1fr}@media(min-width:1100px){main.two{grid-template-columns:1fr 1.6fr}}
section.tier{border:1px solid var(--line);border-radius:10px;background:var(--card);padding:16px 18px}
section.tier>h2{margin:0 0 4px;font-size:15px;letter-spacing:.04em;text-transform:uppercase}section.tier>p.lead{margin:0 0 14px;color:var(--dim)}
.os>h2{color:var(--os)}.hm>h2{color:var(--hm)}
.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin-bottom:14px}
.tile{border:1px solid var(--line);border-radius:8px;padding:10px 12px}.tile b{display:block}.tile span{color:var(--dim)}
h3{margin:16px 0 6px;font-size:13px;color:var(--dim);text-transform:uppercase;letter-spacing:.06em}
table{width:100%;border-collapse:collapse}td,th{padding:4px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{color:var(--dim);font-weight:normal}
td.state{white-space:nowrap}.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px;vertical-align:middle}
.ON{background:var(--on)}.OFF{background:var(--off)}.UNKNOWN{background:var(--unk)}.UNVERIFIABLE{background:var(--dim)}
.present .dot{background:var(--on)}.absent .dot{background:var(--off)}
.app{color:var(--acc)}.kind{color:var(--dim)}td.path{color:var(--dim);word-break:break-all}
footer{padding:14px 24px;color:var(--dim);border-top:1px solid var(--line)}code{color:var(--fg)}
.gen{display:inline-block;margin:2px 6px 2px 0;padding:1px 8px;border:1px solid var(--line);border-radius:12px}.gen.live{border-color:var(--on);color:var(--on)}
.card{border:1px solid var(--line);border-radius:8px;padding:10px 12px;margin-bottom:10px}.card h4{margin:0 0 6px;font-size:13px}.card .sum{color:var(--dim);float:right}
.steps{display:flex;gap:18px;flex-wrap:wrap;margin:0 0 12px}.steps div{color:var(--dim)}.steps b{color:var(--fg)}
EOF
}

html_head() {  # title  active(store|account)
    printf '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>%s</title><style>' "$1"
    html_css
    printf '</style></head><body><header><h1>%s</h1><nav><a href="index.html"%s>Store</a><a href="account.html"%s>Account</a></nav><span class="meta">%s · %s · generated %s</span></header>\n' \
        "$1" "$( [ "$2" = store ] && echo ' style="color:var(--fg)"')" "$( [ "$2" = account ] && echo ' style="color:var(--fg)"')" \
        "$(id -un)@$(uname -n)" "$(uname -s) $(uname -m)" "$(date -u +%FT%TZ)"
}

cmd_html() {
    local p live gb m mdir out n app
    p="$(detect_profile)" || exit 1
    live="$(readlink "$CUR" 2>/dev/null || true)"; gb="$(git_base 2>/dev/null || true)"
    m="$(machine_of "$p")"; mdir="$gb/cloud-me_configs/B_CONFIGS-MACHINES"
    [ -d "$mdir" ] && mdir="$(ls -d "$mdir"/*-"$m" 2>/dev/null | head -1)" || mdir=""
    mkdir -p "$UI"; out="$UI/index.html"
    {
        html_head "linux-store · $p" store
        echo '<main class="two">'
        # ── OS · Terraforms ──
        printf '<section class="tier os"><h2>OS · Terraforms</h2><p class="lead">The machine, not the user: owned by <code>cloud-me_configs/B_CONFIGS-MACHINES/%s</code>. linux-store reads it, never writes it.</p>\n' "$(basename "${mdir:-<none>}" | hesc)"
        echo '<div class="tiles">'
        printf '<div class="tile"><b>%s</b><span>machine · %s</span></div>' "$m" "$p"
        printf '<div class="tile"><b>%s</b><span>kernel</span></div>' "$(uname -r | hesc)"
        printf '<div class="tile"><b>%s</b><span>userland</span></div>' "$( (. /etc/os-release 2>/dev/null && printf '%s' "$PRETTY_NAME") | hesc)"
        for t in nix-os-flakes deb-os-configs cloud-terraforms; do
            if [ -n "$mdir" ] && [ -d "$mdir/$t" ]; then n="$(find "$mdir/$t" -type f ! -name .gitkeep | wc -l | tr -d ' ')"; else n="—"; fi
            printf '<div class="tile"><b>%s</b><span>%s</span></div>' "$t" "$( [ "$n" = "—" ] && echo 'not checked out' || echo "$n files")"
        done
        echo '</div>'
        [ -n "$mdir" ] && [ -f "$mdir/README.md" ] && { echo '<pre style="color:var(--dim);white-space:pre-wrap">'; head -12 "$mdir/README.md" | hesc; echo '</pre>'; }
        echo '</section>'
        # ── Home-Manager · Desktop ──
        printf '<section class="tier hm"><h2>Home-Manager · Desktop</h2><p class="lead">The user: what this store realises in <code>%s</code> from <code>%s</code>.</p>\n' "$(printf '%s' "$HOME" | hesc)" "$(printf '%s' "${DECL:-}" | sed "s|^$gb/||" | hesc)"
        if [ -n "$live" ] && [ -f "$live/manifest.json" ]; then
            printf '<div class="tiles"><div class="tile"><b>%s</b><span>live generation</span></div><div class="tile"><b>%s</b><span>store objects · %s</span></div><div class="tile"><b>%s</b><span>declared · absent</span></div></div>\n' \
                "${live##*/}" "$(ls -1 "$STORE" 2>/dev/null | wc -l | tr -d ' ')" "$(du -sh "$STORE" 2>/dev/null | cut -f1)" "$(jq -r '[.entries[] | select(.kind == "absent")] | length' "$live/manifest.json")"
            for sec in "bin:Binaries" "lib:Scripts · Libs" "etc:Configs" "activate:Rendered configs" "secret:Secrets"; do
                l="${sec%%:*}"
                [ "$(jq -r --arg l "$l" '[.entries[] | select(.layer == $l)] | length' "$live/manifest.json")" != 0 ] || continue
                printf '<h3>%s</h3><table><tr><th></th><th>name</th><th>app</th><th>kind</th><th>%s</th></tr>\n' "${sec#*:}" "$( [ "$l" = secret ] && echo mode || echo where)"
                jq -r --arg l "$l" --arg gb "$gb" --arg home "$HOME" '
                    .entries[] | select(.layer == $l)
                    | (if (.app // "") != "" then .app
                       elif (.source | startswith($gb + "/")) then (.source | ltrimstr($gb + "/") | split("/")[1] // split("/")[0])
                       elif .kind == "host" or .kind == "host+wrap" then "host"
                       elif .kind == "fetch" then (.source | split("/")[-2] // "release")
                       else "" end) as $app
                    | (if $l == "secret" then (.source | fromjson | .mode) else (.target | sub("^" + $home + "/"; "~/") | sub("^.*/store/"; "store/")) end) as $where
                    | "<tr class=\"\(if .kind == "absent" then "absent" else "present" end)\"><td class=\"state\"><span class=\"dot\"></span>\(if .kind == "absent" then "absent" else "present" end)</td><td>\(.name)</td><td class=\"app\">\($app)</td><td class=\"kind\">\(.kind)</td><td class=\"path\">\($where)</td></tr>"' "$live/manifest.json" | hesc | sed 's/&lt;\(\/\?\(tr\|td\|span\)[^&]*\)&gt;/<\1>/g'
                echo '</table>'
            done
            echo '<h3>Generations</h3><div>'
            for g in $(cd "$GENS" 2>/dev/null && ls -1d "$p"-* 2>/dev/null | sort -t- -k2,2n); do
                [ "$GENS/$g" = "$live" ] && printf '<span class="gen live">%s</span>' "$g" || printf '<span class="gen">%s</span>' "$g"
            done; echo '</div>'
        else
            echo '<p>Nothing live — <code>linux-store switch</code>.</p>'
        fi
        echo '</section></main>'
        printf '<footer>linux-store · <code>switch</code> <code>check</code> <code>rollback</code> <code>tui</code> · page: <code>linux-store html</code> · served by my-webserver: <code>linux-store serve</code></footer></body></html>\n'
    } > "$out.tmp" && mv -f "$out.tmp" "$out"
    say "html: $out"
}

# serve: my-webserver (ours) on $HOME, so the page is /.linux-store/ui/index.html.
cmd_serve() {
    local port="${1:-8000}" pidf="$UI/webserver.pid" rel
    cmd_html >/dev/null
    rel="$(printf '%s' "$UI" | sed "s|^$HOME/||")"
    if [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; then
        say "already serving (pid $(cat "$pidf")): http://localhost:$port/$rel/index.html"; return 0
    fi
    if command -v my-webserver >/dev/null 2>&1; then
        nohup my-webserver "$port" "$HOME" > "$UI/webserver.log" 2>&1 &
        echo $! > "$pidf"; say "my-webserver started (pid $!) — http://localhost:$port/$rel/index.html"
    else
        command -v python3 >/dev/null 2>&1 || die "neither my-webserver nor python3 on PATH"
        say "my-webserver not on PATH (declare it in the store: it is a release asset) — falling back to python3 http.server"
        (cd "$HOME" && nohup python3 -m http.server "$port" --bind 127.0.0.1 > "$UI/webserver.log" 2>&1 &
         echo $! > "$pidf")
        say "serving — http://localhost:$port/$rel/index.html"
    fi
}

usage() {
    cat <<'EOF'
linux-store — nix-store semantics for the termux and desktop Linux userlands

Same verbs as nix / home-manager / the flakes' build.sh:

  switch [--backup]          build a generation from the declaration and make it live
  build [--profile p]        build only, no switch (p = termux | desktop)
  update [--no-switch]       pull the checkouts the declaration reads, then switch
  rollback                   make the previous generation of this profile live
  switch-generation <gen>    make <gen> live (e.g. termux-3, or just 3)
  list-generations           list generations, marking the live one
  check                      every link, store object hash, activated file and secret
  repair                     check; if anything is wrong, switch
  diff <a> [<b>]             compare two generations (b defaults to the live one)
  gc                         delete store objects no kept generation references
  dev [--off] <etc path>     link an etc entry straight to its repo source (or back)
  show                       what the declaration resolves to for this profile
  status                     profile, live generation, store size
  tui                        the Store tab in the terminal (PHONE | CLOUD), like the flakes' build.sh tui
  html                       render ~/.linux-store/ui/index.html: OS · Terraforms vs Home-Manager · Desktop
  serve [port]               html, then serve $HOME with my-webserver → /.linux-store/ui/index.html
  profile                    print the detected profile

Declaration: <git base>/cloud-me_configs/<configs-user>/deb-user-configs/linux-store.json

Environment: LINUX_STORE_ROOT  LINUX_STORE_DECLARATION  LINUX_STORE_USER
             LINUX_STORE_PROFILE  LINUX_STORE_KEEP  GIT_BASE  LINUX_STORE_FAULT (tests)
EOF
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
    switch)      cmd_switch "$@" ;;
    build)       cmd_build "$@" ;;
    update)      cmd_update "$@" ;;
    check)       check ;;
    repair)      if check; then say "nothing to repair"; else say "repairing from the declaration"; cmd_switch "$@"; fi ;;
    rollback)    cmd_rollback ;;
    switch-generation) [ $# -eq 1 ] || die "usage: switch-generation <gen>"; cmd_switch_generation "$1" ;;
    list-generations)  cmd_list_generations ;;
    show)        cmd_show ;;
    status)      cmd_status ;;
    tui)         cmd_tui ;;
    html)        cmd_html ;;
    serve)       cmd_serve "$@" ;;
    diff)        cmd_diff "$@" ;;
    gc)          cmd_gc ;;
    dev)         cmd_dev "$@" ;;
    profile)     detect_profile ;;
    help|-h|--help) usage ;;
    *)           usage >&2; exit 2 ;;
esac
